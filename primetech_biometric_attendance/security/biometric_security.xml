<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="biometric_device_details_company_rule" model="ir.rule">
        <field name="name">Pointeuses : sociétés autorisées</field>
        <field name="model_id" ref="model_biometric_device_details"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="biometric_attendance_schedule_company_rule" model="ir.rule">
        <field name="name">Horaires de pointage : sociétés autorisées</field>
        <field name="model_id" ref="model_biometric_attendance_schedule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="biometric_attendance_day_company_rule" model="ir.rule">
        <field name="name">Journées de présence : sociétés autorisées</field>
        <field name="model_id" ref="model_biometric_attendance_day"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="zk_machine_attendance_company_rule" model="ir.rule">
        <field name="name">Pointages : sociétés autorisées</field>
        <field name="model_id" ref="model_zk_machine_attendance"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="biometric_sync_log_company_rule" model="ir.rule">
        <field name="name">Journal des pointeuses : sociétés autorisées</field>
        <field name="model_id" ref="model_biometric_sync_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
