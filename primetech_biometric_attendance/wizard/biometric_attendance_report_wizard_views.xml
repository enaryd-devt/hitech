<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="biometric_attendance_report_wizard_view_form" model="ir.ui.view">
        <field name="name">biometric.attendance.report.wizard.form</field>
        <field name="model">biometric.attendance.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Rapport de présence">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="show_details"/>
                    </group>
                    <group>
                        <field name="department_id"/>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" string="Imprimer (PDF)" type="object" class="btn-primary" icon="fa-print"/>
                    <button name="action_open_analysis" string="Analyser à l’écran" type="object" class="btn-secondary" icon="fa-table"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="biometric_attendance_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Rapport de présence</field>
        <field name="res_model">biometric.attendance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
