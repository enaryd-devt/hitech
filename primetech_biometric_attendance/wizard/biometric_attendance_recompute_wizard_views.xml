<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="biometric_attendance_recompute_wizard_view_form" model="ir.ui.view">
        <field name="name">biometric.attendance.recompute.wizard.form</field>
        <field name="model">biometric.attendance.recompute.wizard</field>
        <field name="arch" type="xml">
            <form string="Recalculer les présences">
                <p class="text-muted">
                    Réanalyse les pointages de la période avec les horaires actuels : retards, absences, heures travaillées et présences Odoo.
                    Les justifications déjà saisies sont conservées.
                </p>
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="department_id"/>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_recompute" string="Recalculer" type="object" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="biometric_attendance_recompute_wizard_action" model="ir.actions.act_window">
        <field name="name">Recalculer les présences</field>
        <field name="res_model">biometric.attendance.recompute.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
