<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="biometric_device_details_view_list" model="ir.ui.view">
        <field name="name">biometric.device.details.view.list</field>
        <field name="model">biometric.device.details</field>
        <field name="arch" type="xml">
            <list decoration-success="last_sync_state == 'success'" decoration-warning="last_sync_state == 'warning'" decoration-danger="last_sync_state == 'error'">
                <field name="name"/>
                <field name="device_ip"/>
                <field name="port_number"/>
                <field name="address_id" optional="show"/>
                <field name="timezone" optional="hide"/>
                <field name="info_user_count" optional="show"/>
                <field name="info_record_count" optional="show"/>
                <field name="last_sync_at"/>
                <field name="last_punch_at" optional="show"/>
                <field name="last_sync_state" widget="badge" decoration-success="last_sync_state == 'success'" decoration-warning="last_sync_state == 'warning'" decoration-danger="last_sync_state == 'error'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="biometric_device_details_view_kanban" model="ir.ui.view">
        <field name="name">biometric.device.details.view.kanban</field>
        <field name="model">biometric.device.details</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="is_online"/>
                <field name="last_sync_state"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start">
                            <field name="name" class="fw-bold fs-5"/>
                            <span t-if="record.is_online.raw_value" class="badge text-bg-success">En ligne</span>
                            <span t-else="" class="badge text-bg-danger">Hors ligne</span>
                        </div>
                        <div class="text-muted"><field name="device_ip"/>:<field name="port_number"/></div>
                        <div class="mt-2 small">
                            <i class="fa fa-users me-1" title="Utilisateurs"/><field name="info_user_count"/> utilisateurs
                            <i class="fa fa-database ms-3 me-1" title="Pointages en mémoire"/><field name="info_record_count"/> pointages
                        </div>
                        <div class="small text-muted mt-1">Dernière synchro : <field name="last_sync_at"/></div>
                        <div class="small mt-1" t-if="record.last_sync_state.raw_value == 'error'">
                            <field name="last_sync_message" class="text-danger"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="biometric_device_details_view_form" model="ir.ui.view">
        <field name="name">biometric.device.details.view.form</field>
        <field name="model">biometric.device.details</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_synchronize_now" string="Synchroniser maintenant" type="object" class="oe_highlight" icon="fa-refresh" invisible="connection_mode == 'relay'"/>
                    <button name="action_download_relay" string="Télécharger la passerelle" type="object" class="oe_highlight" icon="fa-download" groups="hr_attendance.group_hr_attendance_manager" invisible="connection_mode != 'relay'"/>
                    <button name="action_test_connection" string="Tester la connexion" type="object" icon="fa-plug" invisible="connection_mode == 'relay'"/>
                    <button name="action_refresh_info" string="Lire les informations" type="object" icon="fa-info-circle" groups="hr_attendance.group_hr_attendance_manager" invisible="connection_mode == 'relay'"/>
                    <button name="action_set_timezone" string="Régler l’heure" type="object" icon="fa-clock-o" groups="hr_attendance.group_hr_attendance_manager" confirm="Régler l’horloge de la pointeuse sur l’heure actuelle de son fuseau horaire ?"/>
                    <button name="action_import_users" string="Importer les utilisateurs" type="object" icon="fa-download" groups="hr_attendance.group_hr_attendance_manager" invisible="connection_mode == 'relay'"/>
                    <button name="action_synchronize_users" string="Envoyer les utilisateurs" type="object" icon="fa-upload" groups="hr_attendance.group_hr_attendance_manager" confirm="Envoyer tous les utilisateurs associés vers la pointeuse ?" invisible="connection_mode == 'relay'"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_punches" type="object" class="oe_stat_button" icon="fa-hand-pointer-o">
                            <field name="punch_count" widget="statinfo" string="Pointages"/>
                        </button>
                        <button name="action_view_device_users" type="object" class="oe_stat_button" icon="fa-user-times" invisible="not unmapped_user_count">
                            <field name="unmapped_user_count" widget="statinfo" string="Non associés"/>
                        </button>
                        <button name="action_view_logs" type="object" class="oe_stat_button" icon="fa-list-alt" string="Journal"/>
                    </div>
                    <widget name="web_ribbon" title="Hors ligne" bg_color="text-bg-danger" invisible="is_online or last_sync_state == 'never'"/>
                    <widget name="web_ribbon" title="En ligne" bg_color="text-bg-success" invisible="not is_online"/>
                    <field name="is_online" invisible="1"/>
                    <div class="oe_title"><label for="name"/><h1><field name="name" placeholder="ex. Pointeuse entrée principale"/></h1></div>
                    <div class="alert alert-danger" role="alert" invisible="last_sync_state != 'error'">
                        <strong>Erreur de synchronisation : </strong><field name="last_sync_message" class="d-inline"/>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="last_sync_state != 'warning'">
                        <field name="last_sync_message" class="d-inline"/>
                        <div>Associez ces identifiants à des employés dans <strong>Utilisateurs des pointeuses</strong> : leurs pointages seront importés à la synchronisation suivante.</div>
                    </div>
                    <group>
                        <group string="Connexion">
                            <field name="active" invisible="1"/>
                            <field name="connection_mode" widget="radio"/>
                            <field name="device_ip" placeholder="192.168.1.201"/>
                            <field name="port_number"/>
                            <field name="comm_key" password="True"/>
                            <field name="connection_timeout"/>
                            <field name="force_udp"/>
                        </group>
                        <group string="Fonctionnement">
                            <field name="timezone"/>
                            <field name="sync_interval"/>
                            <field name="import_from_date"/>
                            <field name="create_unknown_employee"/>
                            <field name="address_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="État">
                        <group>
                            <field name="last_sync_state" widget="badge" decoration-success="last_sync_state == 'success'" decoration-warning="last_sync_state == 'warning'" decoration-danger="last_sync_state == 'error'"/>
                            <field name="last_sync_at"/>
                            <field name="last_contact_at"/>
                        </group>
                        <group>
                            <field name="last_punch_at"/>
                            <field name="last_sync_message" invisible="last_sync_state in ('error', 'warning')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Informations de l’appareil" name="info">
                            <group>
                                <group string="Matériel">
                                    <field name="info_device_name"/>
                                    <field name="info_serial"/>
                                    <field name="info_firmware"/>
                                    <field name="info_platform"/>
                                    <field name="info_mac"/>
                                </group>
                                <group string="Mémoire">
                                    <label for="info_user_count" string="Utilisateurs"/>
                                    <div><field name="info_user_count" class="oe_inline"/> / <field name="info_user_capacity" class="oe_inline"/></div>
                                    <label for="info_finger_count" string="Empreintes"/>
                                    <div><field name="info_finger_count" class="oe_inline"/> / <field name="info_finger_capacity" class="oe_inline"/></div>
                                    <label for="info_face_count" string="Visages"/>
                                    <div><field name="info_face_count" class="oe_inline"/> / <field name="info_face_capacity" class="oe_inline"/></div>
                                    <label for="info_record_count" string="Pointages"/>
                                    <div><field name="info_record_count" class="oe_inline"/> / <field name="info_record_capacity" class="oe_inline"/></div>
                                    <field name="info_memory_usage" widget="progressbar"/>
                                </group>
                                <group string="Horloge">
                                    <field name="info_time_drift" decoration-danger="info_time_drift &gt; 60 or info_time_drift &lt; -60"/>
                                    <field name="info_updated_at"/>
                                </group>
                            </group>
                            <div class="text-muted" invisible="info_updated_at">Cliquez sur « Lire les informations » pour interroger la pointeuse.</div>
                        </page>
                        <page string="Utilisateurs sur l’appareil" name="users" groups="hr_attendance.group_hr_attendance_manager">
                            <field name="device_user_ids" context="{'default_device_id': id}">
                                <list editable="bottom" decoration-danger="not employee_id" decoration-muted="not active">
                                    <field name="device_user_id"/>
                                    <field name="device_user_name"/>
                                    <field name="employee_id"/>
                                    <field name="device_uid" readonly="1" optional="hide"/>
                                    <field name="privilege"/>
                                    <field name="card" optional="hide"/>
                                    <field name="sync_state" widget="badge" decoration-success="sync_state == 'synced'" decoration-danger="sync_state == 'error'"/>
                                    <field name="active" optional="hide"/>
                                    <button name="action_push_to_device" string="Envoyer" type="object" icon="fa-upload" invisible="not employee_id"/>
                                    <button name="action_remove_from_device" string="Retirer" type="object" icon="fa-trash" confirm="Retirer cet utilisateur de la pointeuse ?"/>
                                </list>
                            </field>
                        </page>
                        <page string="Journal" name="logs">
                            <field name="sync_log_ids" readonly="1">
                                <list limit="20" decoration-danger="state == 'error'" decoration-warning="state == 'warning'">
                                    <field name="date"/>
                                    <field name="operation"/>
                                    <field name="state" widget="badge" decoration-success="state == 'success'" decoration-warning="state == 'warning'" decoration-danger="state == 'error'"/>
                                    <field name="records_created"/>
                                    <field name="message"/>
                                    <field name="user_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Passerelle" name="relay" groups="hr_attendance.group_hr_attendance_manager">
                            <div class="alert alert-info" role="alert">
                                <p class="mb-1"><strong>Comment ça marche ?</strong> Un PC du site lit la pointeuse sur le réseau local et envoie les pointages à Odoo par Internet. Les pointages faits quand tous les PC sont éteints restent dans la pointeuse et sont envoyés, avec leur heure réelle, dès qu’un PC démarre.</p>
                                <p class="mb-0">Cliquez sur <strong>Télécharger la passerelle</strong>, copiez le dossier sur un ou plusieurs PC du site et lancez <code>installer.bat</code> en tant qu’administrateur.</p>
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-3 border rounded p-3 mb-3">
                                <div class="flex-grow-1">
                                    <strong>Associer une passerelle</strong>
                                    <div class="text-muted small">Dans la console de la passerelle (raccourci « Pointeuse PrimeTech » sur le PC), choisissez « Ajouter une pointeuse », saisissez l’adresse de ce serveur Odoo puis ce code.</div>
                                </div>
                                <div invisible="not relay_pairing_code" class="text-center">
                                    <field name="relay_pairing_code" class="fs-2 fw-bold font-monospace" widget="CopyClipboardChar"/>
                                    <div class="small text-muted">valable jusqu’au <field name="relay_pairing_expiry" class="d-inline"/></div>
                                </div>
                                <button name="action_generate_pairing_code" type="object" string="Générer un code d’association" class="btn-primary" icon="fa-link"/>
                            </div>
                            <group>
                                <group string="Sécurité">
                                    <field name="relay_token" widget="CopyClipboardChar" readonly="1" invisible="not relay_token"/>
                                    <button name="action_generate_relay_token" type="object" string="Générer une nouvelle clé" class="btn-link ps-0" icon="fa-key" colspan="2" confirm="Les passerelles déjà installées devront recevoir la nouvelle clé (nouveau téléchargement). Continuer ?"/>
                                </group>
                                <group string="Activité">
                                    <field name="relay_agent"/>
                                    <field name="relay_pending_commands" invisible="not relay_pending_commands"/>
                                    <field name="relay_resend_all"/>
                                </group>
                            </group>
                        </page>
                        <page string="Maintenance" name="maintenance" groups="hr_attendance.group_hr_attendance_manager">
                            <div class="row g-3">
                                <div class="col-lg-4">
                                    <h5><i class="fa fa-eraser me-1"/>Vider la mémoire de la pointeuse</h5>
                                    <p class="text-muted">Importe d’abord les nouveaux pointages, puis efface la mémoire de l’appareil. Les pointages restent conservés dans Odoo.</p>
                                    <button name="action_clear_device_log" string="Vider la mémoire" type="object" class="btn-secondary" confirm="Les nouveaux pointages vont être importés puis effacés de la pointeuse. Continuer ?"/>
                                </div>
                                <div class="col-lg-4">
                                    <h5><i class="fa fa-history me-1"/>Réimporter les pointages</h5>
                                    <p class="text-muted">Supprime les pointages importés depuis cet appareil puis les relit depuis sa mémoire (utile après un changement de fuseau horaire). Les saisies manuelles sont conservées.</p>
                                    <button name="action_reimport_attendance" string="Réimporter" type="object" class="btn-secondary" confirm="Les pointages importés depuis cet appareil vont être supprimés puis relus depuis sa mémoire. Les pointages déjà effacés de l’appareil seront perdus. Continuer ?"/>
                                </div>
                                <div class="col-lg-4">
                                    <h5><i class="fa fa-power-off me-1"/>Redémarrer l’appareil</h5>
                                    <p class="text-muted">La pointeuse est indisponible pendant environ une minute.</p>
                                    <button name="action_restart_device" string="Redémarrer" type="object" class="btn-secondary" confirm="Voulez-vous vraiment redémarrer cette pointeuse ?"/>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="biometric_device_details_view_search" model="ir.ui.view">
        <field name="name">biometric.device.details.view.search</field>
        <field name="model">biometric.device.details</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="device_ip"/>
                <filter string="En erreur" name="error" domain="[('last_sync_state', '=', 'error')]"/>
                <separator/>
                <filter string="Archivées" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="biometric_device_details_action" model="ir.actions.act_window">
        <field name="name">Pointeuses biométriques</field>
        <field name="res_model">biometric.device.details</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Déclarez votre première pointeuse</p>
            <p>Indiquez son adresse IP et son port (4370 par défaut), puis testez la connexion et importez ses utilisateurs.</p>
        </field>
    </record>
</odoo>
