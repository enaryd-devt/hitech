<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.primetech.biometric</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_biometric_days" type="object" class="oe_stat_button" icon="fa-calendar-check-o" groups="hr_attendance.group_hr_attendance_manager">
                    <field name="biometric_day_count" widget="statinfo" string="Journées pointées"/>
                </button>
            </div>
            <xpath expr="//group[@name='identification_group']" position="after">
                <group string="Pointeuse biométrique" name="biometric_group" groups="hr_attendance.group_hr_attendance_manager">
                    <field name="device_id_num"/>
                    <field name="biometric_tracked"/>
                    <field name="biometric_schedule_id" placeholder="Horaire du département ou de la société"/>
                    <field name="biometric_effective_schedule_id" invisible="biometric_schedule_id or not biometric_effective_schedule_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_employee_tree" model="ir.ui.view">
        <field name="name">hr.employee.view.list.inherit.primetech.biometric</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <field name="work_email" position="after">
                <field name="device_id_num" optional="hide" groups="hr_attendance.group_hr_attendance_manager"/>
                <field name="biometric_schedule_id" optional="hide" groups="hr_attendance.group_hr_attendance_manager"/>
                <field name="biometric_tracked" optional="hide" groups="hr_attendance.group_hr_attendance_manager"/>
            </field>
        </field>
    </record>

    <record id="view_department_form" model="ir.ui.view">
        <field name="name">hr.department.view.form.inherit.primetech.biometric</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <field name="biometric_schedule_id" groups="hr_attendance.group_hr_attendance_manager"/>
            </field>
        </field>
    </record>
</odoo>
