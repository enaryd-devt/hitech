<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="sequence_primetech_customer_invoice_proforma" model="ir.sequence">
        <field name="name">Proforma facture client</field>
        <field name="code">primetech.customer.invoice.proforma</field>
        <field name="prefix">PRO-CL/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="sequence_primetech_supplier_invoice_proforma" model="ir.sequence">
        <field name="name">Proforma facture fournisseur</field>
        <field name="code">primetech.supplier.invoice.proforma</field>
        <field name="prefix">PRO-FO/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
