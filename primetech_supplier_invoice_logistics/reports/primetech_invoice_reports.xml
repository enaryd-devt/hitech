<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_primetech_invoice" model="report.paperformat">
        <field name="name">Facture Primetech A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <!-- This top margin is reserved by wkhtmltopdf on *every* page for
             the external-layout header.  Never simulate it with page padding:
             CSS padding only protects the first page of a long document. -->
        <!-- Réserve la place nécessaire à l'en-tête externe complet. -->
        <field name="margin_top">40</field>
        <field name="margin_bottom">24</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <!-- Positionne l'en-tête externe près du bord supérieur. -->
        <field name="header_spacing">40</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_primetech_customer_invoice" model="ir.actions.report">
        <field name="name">Facture client</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">primetech_supplier_invoice_logistics.report_primetech_customer_invoice</field>
        <field name="report_file">primetech_supplier_invoice_logistics.report_primetech_customer_invoice</field>
        <field name="print_report_name">('Facture proforma - %s - %s' if object.state == 'draft' else 'Facture client - %s - %s') % (object._primetech_document_reference(), object.partner_id.name or 'Sans client')</field>
        <field name="paperformat_id" ref="paperformat_primetech_invoice"/>
    </record>

    <record id="action_report_primetech_supplier_invoice" model="ir.actions.report">
        <field name="name">Facture fournisseur</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">primetech_supplier_invoice_logistics.report_primetech_supplier_invoice</field>
        <field name="report_file">primetech_supplier_invoice_logistics.report_primetech_supplier_invoice</field>
        <field name="print_report_name">('Cotation fournisseur - %s - %s' if object.state == 'draft' else 'Facture fournisseur - %s - %s') % (object._primetech_document_reference(), object.partner_id.name or 'Sans fournisseur')</field>
        <field name="paperformat_id" ref="paperformat_primetech_invoice"/>
    </record>

    <!-- Gabarit unique issu de l'identité visuelle HiTech : il se répète sur
         chaque page imprimée tout en laissant les marges réservées au contenu. -->
    <template id="report_primetech_hitech_page_frame">
        <style type="text/css">
            .pt-hitech-document-frame {
                box-sizing:border-box;
                min-height:233mm;
                padding:0 8mm;
                position:relative;
            }
            .pt-hitech-document-frame__background { display:block; height:297mm; left:0; max-width:none; position:absolute; top:-40mm; width:210mm; z-index:0; }
            .pt-hitech-document-frame > :not(.pt-hitech-document-frame__background) { position:relative; z-index:1; }
        </style>
    </template>

    <template id="report_primetech_hitech_a4_layout">
        <style type="text/css">
            .pt-hitech-a4-sheet { box-sizing:border-box; height:297mm; margin:0; overflow:hidden; padding:0; position:relative; width:210mm; }
            .pt-hitech-a4-sheet__header { display:block; height:40mm; width:210mm; }
            .pt-hitech-a4-sheet__body { box-sizing:border-box; height:233mm; overflow:hidden; padding:0 8mm; position:relative; width:210mm; }
            .pt-hitech-a4-sheet__watermark { height:233mm; left:0; max-width:none; position:absolute; top:0; width:210mm; z-index:0; }
            .pt-hitech-a4-sheet__body > .page { background:transparent !important; box-sizing:border-box; margin:0; min-height:233mm; padding:0; position:relative; width:100%; z-index:1; }
            .pt-hitech-a4-sheet__footer { display:block; height:24mm; width:210mm; }
        </style>
        <div class="pt-hitech-a4-sheet">
            <img class="pt-hitech-a4-sheet__header" src="/primetech_supplier_invoice_logistics/static/src/img/hitech_document_header.jpeg" alt=""/>
            <div class="pt-hitech-a4-sheet__body">
                <img class="pt-hitech-a4-sheet__watermark" src="/primetech_supplier_invoice_logistics/static/src/img/hitech_document_middle.jpeg" alt=""/>
                <t t-out="0"/>
            </div>
            <img class="pt-hitech-a4-sheet__footer" src="/primetech_supplier_invoice_logistics/static/src/img/hitech_document_footer.jpeg" alt=""/>
        </div>
    </template>

    <!-- External layout natif : wkhtmltopdf rÃ©pÃ¨te automatiquement l'en-tÃªte
         et le pied Ã  chaque page, sans les injecter dans le flux du document. -->
    <template id="report_primetech_hitech_external_layout">
        <style type="text/css">
            /* L'en-tête est volontairement un peu réduit : wkhtmltopdf rognait
               l'extrémité droite de l'image lorsqu'elle occupait 100 % de la zone. */
            .pt-hitech-report-header { margin:0 auto !important; padding:0; position:relative; width:96%; }
            .pt-hitech-report-footer { margin:0 auto; padding:0; position:relative; width:100%; }
            .pt-hitech-report-header img { display:block; height:auto; margin:0 auto; max-width:100%; object-fit:contain; width:100%; }
            .pt-hitech-report-footer img { display:block; height:auto; margin:0 auto; max-width:100%; width:100%; }
            .pt-hitech-report-article { background:transparent url('/primetech_supplier_invoice_logistics/static/src/img/hitech_document_middle.jpeg') 0 0 / 210mm 233mm no-repeat; min-height:233mm; }
            .pt-hitech-report-article > .page { background:transparent !important; box-sizing:border-box; margin:0; padding:0 8mm; }
        </style>
        <div t-attf-class="header o_company_#{company.id}_layout pt-hitech-report-header">
            <!-- Les en-têtes PDF sont rendus dans un document wkhtmltopdf distinct :
                 le style est donc porté directement par l'image pour éviter tout rognage. -->
            <img src="/primetech_supplier_invoice_logistics/static/src/img/hitech_document_header.jpeg"
                 alt="High-Tech DZ SARL"
                 style="display:block !important; width:257mm !important; max-width:257mm !important; height:auto !important; margin:0 !important;"/>
        </div>
        <div t-attf-class="article o_company_#{company.id}_layout pt-hitech-report-article"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0"/>
        </div>
        <div t-attf-class="footer o_company_#{company.id}_layout pt-hitech-report-footer {{report_type != 'pdf' and 'mt-auto'}}">
            <img src="/primetech_supplier_invoice_logistics/static/src/img/hitech_document_footer.jpeg" alt=""/>
        </div>
    </template>

    <template id="report_primetech_hitech_header">
        <style type="text/css">
            /* Le header est rendu par wkhtmltopdf dans une page séparée.
               Ne pas utiliser position:fixed ou de marge négative : ces deux
               techniques le font rogner par le moteur PDF. */
            .header.o_company_1_layout, .header[class*="o_company_"] {
                margin:0 !important;
                padding:5px 0 0 !important;
            }
            .pt-hitech-header { border-bottom:1px solid #0868c9; color:#17213c; font-family:Arial,sans-serif; height:48mm; margin:0; padding-bottom:2px; position:relative; width:100%; }
            .pt-hitech-header__main { display:table; height:35mm; table-layout:fixed; width:100%; }
            .pt-hitech-header__logo { display:table-cell; text-align:center; vertical-align:middle; width:27%; }
            .pt-hitech-header__logo img { max-height:34mm; max-width:100%; }
            .pt-hitech-header__body { border-left:1mm solid #0968c7; display:table-cell; padding-left:5mm; vertical-align:middle; width:73%; }
            .pt-hitech-header__title { color:#075fc2; font-size:39pt; font-weight:900; letter-spacing:-1.7px; line-height:1; white-space:nowrap; }
            .pt-hitech-header__title b { color:#ff7200; }
            .pt-hitech-header__accent { display:table; height:2px; margin:2mm 0; width:100%; }
            .pt-hitech-header__accent:before { background:#0868c9; content:''; display:table-cell; width:48%; }
            .pt-hitech-header__accent:after { background:#ff7200; content:''; display:table-cell; width:52%; }
            .pt-hitech-header__contacts { display:table; table-layout:fixed; width:100%; }
            .pt-hitech-header__phone, .pt-hitech-header__online { display:table-cell; font-size:11pt; line-height:1.45; vertical-align:top; width:50%; }
            .pt-hitech-header__online { border-left:1px solid #0868c9; padding-left:5mm; }
            .pt-hitech-header strong { color:#0868c9; }
            .pt-hitech-header .pt-orange { color:#ff7200; }
            .pt-hitech-header__services { border-top:2px solid #0868c9; color:#17213c; font-size:9.5pt; margin-top:3mm; padding:2mm 3mm 0; white-space:nowrap; }
            .pt-hitech-header__services strong { font-size:13pt; }
        </style>
        <div class="pt-hitech-header">
            <div class="pt-hitech-header__main">
                <div class="pt-hitech-header__logo">
                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" alt="Hitech DZ"/>
                </div>
                <div class="pt-hitech-header__body">
                    <div class="pt-hitech-header__title">HIGH-TECH- <b>DZ SARL</b></div>
                    <div class="pt-hitech-header__accent"/>
                    <div class="pt-hitech-header__contacts">
                        <div class="pt-hitech-header__phone">
                            <div><strong>● Services clients Number one:</strong> 657878693</div>
                            <div><strong class="pt-orange">● Services clients ancien troisième:</strong> 659595814</div>
                            <div><strong>● Direction:</strong> (+237) 679 576 626 - 655 502 254</div>
                        </div>
                        <div class="pt-hitech-header__online">
                            <div><strong class="pt-orange">✉ Email:</strong> hightechdz9@gmail.com</div>
                            <div><strong>◎ Site web :</strong> www.ngmangang.com</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="pt-hitech-header__services"><strong>SERVICES:</strong>&#160; COMMERCE GÉNÉRAL &#160; ● &#160; VIDÉOS SURVEILLANCE &#160; ● &#160; IMPORT-EXPORT &#160; ● &#160; MAINTENANCE &#160; ● &#160; VENTE DU MATÉRIEL INFORMATIQUE ET ACCESSOIRES (GROS ET DETAIL)</div>
        </div>
    </template>

    <!-- Layout réellement utilisé par la société (external_layout_striped). -->
    <template id="report_primetech_hitech_external_layout_striped" inherit_id="web.external_layout_striped">
        <xpath expr="//div[contains(@t-attf-class, 'header')]" position="replace">
            <div t-attf-class="o_company_#{company.id}_layout header">
                <t t-call="primetech_supplier_invoice_logistics.report_primetech_hitech_header"/>
            </div>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'footer')]" position="replace">
            <div t-attf-class="footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}">
                <t t-call="primetech_supplier_invoice_logistics.report_primetech_hitech_footer"/>
            </div>
        </xpath>
    </template>

    <template id="report_primetech_hitech_footer">
        <style type="text/css">
            .pt-hitech-footer { color:#07509a; font-family:Arial,sans-serif; font-size:8pt; position:relative; text-align:center; width:100%; }
            .pt-hitech-footer__rule { border-top:1px solid #07509a; margin-bottom:2mm; }
            .pt-hitech-footer__content { line-height:1.35; text-align:center; width:100%; }
            .pt-hitech-footer__configured { font-weight:600; }
            .pt-hitech-footer__page { display:block; font-size:7pt; margin-top:1mm; }
        </style>
        <div class="pt-hitech-footer">
            <div class="pt-hitech-footer__rule"/>
            <div class="pt-hitech-footer__content">
                <div t-if="o.company_id.report_footer" class="pt-hitech-footer__configured" t-field="o.company_id.report_footer"/>
                <div t-else="" class="pt-hitech-footer__configured"><span t-esc="o.company_id.name"/></div>
                <span class="pt-hitech-footer__page">Page <span class="page"/> / <span class="topage"/></span>
            </div>
        </div>
    </template>

    <template id="report_primetech_invoice_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.company_id"/>
                <!-- Même layout dynamique que le bouton d'impression natif. -->
                <t t-call="primetech_supplier_invoice_logistics.report_primetech_hitech_external_layout">
                    <div t-attf-class="page pt-pro-invoice #{'pt-pro-invoice--proforma' if o.state == 'draft' and o.move_type == 'out_invoice' else 'pt-pro-invoice--quotation' if o.state == 'draft' else 'pt-pro-invoice--customer' if o.move_type == 'out_invoice' else 'pt-pro-invoice--supplier'}">
                        <style type="text/css">
                            /* L'en-tête externe reste en haut ; le contenu démarre volontairement
                               plus bas pour lui laisser une respiration nette. */
                          .pt-pro-invoice { color:#172b55; font-family:Arial, sans-serif; font-size:13px; padding-top:0; }
                          /* wkhtmltopdf ne prend pas fiablement en charge les variables CSS :
                             chaque bande reçoit donc une couleur explicite et imprimable. */
                          .pt-pro-invoice .pt-title { background:#0759a8 !important; border-radius:5px; color:#fff !important; display:inline-block; font-size:14px; font-weight:700; line-height:1.2; margin:0; padding:7px 11px; white-space:nowrap; }
                          .pt-pro-invoice--customer .pt-title { background:#0759a8 !important; }
                          .pt-pro-invoice--proforma .pt-title { background:#6b49a8 !important; }
                          .pt-pro-invoice--supplier .pt-title { background:#b84b08 !important; }
                          .pt-pro-invoice--quotation .pt-title { background:#147d78 !important; }
                          .pt-pro-invoice .pt-title .pt-number { color:#fff0c5 !important; display:inline-block; white-space:nowrap; }
                            .pt-pro-invoice .pt-document-date { clear:both; color:#1f3f68; font-size:14px; font-style:italic; font-weight:600; margin:7px 3px 11px 0; text-align:right; }
                            .pt-pro-invoice .pt-grid { clear:both; width:100%; }
                            .pt-pro-invoice .pt-col { display:block; width:100%; }
                            .pt-pro-invoice .pt-partner-section { clear:both; margin:12px 0 0 auto; width:49%; }
                            .pt-pro-invoice .pt-card { background:#f3f7fd; border-radius:4px; box-sizing:border-box; min-height:0; padding:11px 15px; width:100%; }
                            .pt-pro-invoice .pt-label { color:#1671c1; font-size:11px; font-weight:700; text-transform:uppercase; }
                            .pt-pro-invoice .pt-partner { color:#122a53; font-size:15px; font-weight:700; margin:5px 0; text-transform:uppercase; }
                            .pt-pro-invoice .pt-meta { border-collapse:collapse; width:100%; }
                            .pt-pro-invoice .pt-meta td { padding:3px 0; }
                            .pt-pro-invoice .pt-meta td:first-child { color:#536c92; width:48%; }
                            .pt-pro-invoice .pt-status { border-radius:12px; display:inline-block; font-size:9px; font-weight:700; padding:3px 8px; }
                            .pt-pro-invoice .pt-status--paid { background:#daf7e8; color:#07834e; }
                            .pt-pro-invoice .pt-status--open { background:#fff0d8; color:#bc6400; }
                            .pt-pro-invoice .pt-traceability { background:#f2f5f9; border:1px solid #183f73 !important; clear:both; margin:12px 0 13px; padding:0; }
                            .pt-pro-invoice .pt-traceability table { border-collapse:collapse; table-layout:fixed; width:100%; }
                            .pt-pro-invoice .pt-traceability table, .pt-pro-invoice .pt-traceability tr, .pt-pro-invoice .pt-traceability td { border:none !important; }
                            .pt-pro-invoice .pt-traceability td { color:#4c6384; font-size:12px; padding:6px 9px; vertical-align:middle; width:25%; }
                            .pt-pro-invoice .pt-traceability tr + tr td { border-top:1px solid #d6dee8 !important; }
                            .pt-pro-invoice .pt-traceability strong { color:#183f73; font-size:12px; font-weight:700; }
                            .pt-pro-invoice .pt-lines { border-collapse:collapse; margin-top:11px; width:100%; }
                            .pt-pro-invoice .pt-lines thead { display:table-header-group; }
                            .pt-pro-invoice .pt-lines tr { page-break-inside:avoid; }
                            .pt-pro-invoice .pt-lines th { background:#084a93; border:1px solid #c5d7ed; color:#fff; font-size:11px; padding:9px 7px; text-align:center; }
                            .pt-pro-invoice .pt-lines td { border:1px solid #d5e1f0; padding:9px 7px; vertical-align:top; }
                            .pt-pro-invoice .pt-lines .pt-right { text-align:right; }
                            .pt-pro-invoice .pt-lines .pt-center { text-align:center; }
                            .pt-pro-invoice .pt-summary { margin-top:10px; }
                            .pt-pro-invoice .pt-summary table { border-collapse:collapse; float:right; width:43%; }
                            .pt-pro-invoice .pt-summary td { border:1px solid #d5e1f0; padding:5px 8px; }
                            .pt-pro-invoice .pt-summary td:last-child { text-align:right; }
                            .pt-pro-invoice .pt-summary .pt-total td { background:#dcecff; color:#063d7e; font-size:13px; font-weight:700; }
                          .pt-pro-invoice .pt-summary .pt-balance td { background:#ff8500 !important; color:#fff !important; font-size:13px; font-weight:700; }
                          .pt-pro-invoice--supplier .pt-summary .pt-balance td { background:#b84b08 !important; color:#fff !important; }
                          .pt-pro-invoice--quotation .pt-summary .pt-balance td { background:#147d78 !important; color:#fff !important; }
                            .pt-pro-invoice .pt-details { margin-top:11px; min-height:93px; width:52%; }
                            .pt-pro-invoice .pt-details p { margin:3px 0; }
                            .pt-pro-invoice .pt-details h4 { color:#084a93; font-size:11px; margin:0 0 6px; text-transform:uppercase; }
                            .pt-pro-invoice .pt-note { background:#dcedff; clear:both; font-style:italic; margin-top:13px; padding:9px 12px; }
                            .pt-pro-invoice .pt-payments { clear:both; margin-top:13px; }
                            .pt-pro-invoice .pt-payments h4 { color:#084a93; font-size:11px; margin:0 0 4px; }
                            .pt-pro-invoice .pt-payments table { border-collapse:collapse; width:100%; }
                            .pt-pro-invoice .pt-payments td, .pt-pro-invoice .pt-payments th { border-bottom:1px solid #d5e1f0; padding:4px; text-align:left; }
                            .pt-pro-invoice .pt-terms { border-top:2px solid #1681d4; color:#405b80; font-size:10px; margin-top:15px; padding-top:9px; }
                            .pt-pro-invoice .pt-signatures { display:table; margin-top:18px; width:100%; }
                            .pt-pro-invoice .pt-signature { display:table-cell; text-align:center; width:50%; }
                            .pt-pro-invoice .pt-sign-box { border:1px solid #d5e1f0; height:94px; margin-top:7px; width:94%; }
                        </style>

                        <t t-set="is_customer" t-value="o.move_type == 'out_invoice'"/>
                        <t t-set="is_draft" t-value="o.state == 'draft'"/>
                        <t t-set="invoice_lines" t-value="o._primetech_report_invoice_lines()"/>
                        <t t-set="columns" t-value="o._primetech_report_column_visibility()"/>
                        <t t-set="trace" t-value="o._primetech_report_traceability()"/>
                        <div class="pt-document-date" t-esc="o._primetech_report_date_in_words()"/>

                        <div class="pt-grid">
                            <div class="pt-col"><div class="pt-title">
                                <t t-if="is_draft and is_customer">FACTURE PROFORMA</t>
                                <t t-elif="is_draft">COTATION FOURNISSEUR</t>
                                <t t-elif="is_customer">FACTURE CLIENT</t>
                                <t t-else="">FACTURE FOURNISSEUR</t>
                                <span class="pt-number"> N° <span t-esc="o._primetech_document_reference()"/></span>
                            </div></div>
                            <div class="pt-partner-section"><div class="pt-card">
                                <div class="pt-label"><t t-if="is_customer">Client</t><t t-else="">Fournisseur</t></div>
                                <div class="pt-partner" t-field="o.partner_id.name"/>
                                <div t-field="o.primetech_customer_address"/>
                                <div t-if="o.partner_id.phone">Tél. : <span t-field="o.partner_id.phone"/></div>
                                <div t-if="o.partner_id.email">E-mail : <span t-field="o.partner_id.email"/></div>
                                <div t-if="o.partner_id.vat">NIU / TVA : <span t-field="o.partner_id.vat"/></div>
                            </div></div>
                        </div>

                        <div class="pt-traceability">
                            <table>
                                <tr>
                                    <td><strong><t t-if="is_customer">Bon(s) de livraison :</t><t t-else="">Bon(s) de réception :</t></strong> <span t-esc="trace['pickings']"/></td>
                                    <td><strong><t t-if="is_customer">Entrepôt de livraison :</t><t t-else="">Entrepôt de réception :</t></strong> <span t-field="o.primetech_delivery_warehouse_id.name" t-if="is_customer and o.primetech_delivery_warehouse_id"/><span t-field="o.primetech_warehouse_id.name" t-if="not is_customer and o.primetech_warehouse_id"/><span t-if="(is_customer and not o.primetech_delivery_warehouse_id) or (not is_customer and not o.primetech_warehouse_id)">—</span></td>
                                    <td><strong>Échéance :</strong> <span t-field="o.invoice_date_due"/></td>
                                    <td><strong><t t-if="is_customer">Vendu par :</t><t t-else="">Demandeur :</t></strong> <span t-esc="trace['seller']"/></td>
                                </tr>
                            </table>
                        </div>

                        <table class="pt-lines">
                            <thead><tr>
                                <th style="width:5%">N°</th><th>Désignation</th><th style="width:11%">Quantité</th><th style="width:16%">Prix unitaire</th><th t-if="columns['discount']" style="width:10%">Remise</th><th style="width:17%">Montant HT</th>
                            </tr></thead>
                            <tbody>
                                <t t-foreach="invoice_lines" t-as="line">
                                    <tr>
                                        <td class="pt-center"><span t-esc="line_index + 1"/></td>
                                        <td><span t-field="line.name"/></td>
                                        <td class="pt-center"><span t-field="line.quantity"/> <span t-field="line.product_uom_id.name"/></td>
                                        <td class="pt-right"><span t-field="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                        <td class="pt-center" t-if="columns['discount']"><span t-field="line.discount"/> %</td>
                                        <td class="pt-right"><span t-field="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="pt-summary">
                            <table>
                                <tr><td>Total HT</td><td><span t-field="o.amount_untaxed" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td></tr>
                                <tr t-if="o.primetech_apply_discount and o.primetech_discount_amount"><td>Réduction appliquée</td><td>- <span t-field="o.primetech_discount_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td></tr>
                                <tr t-if="o.amount_tax"><td>TVA</td><td><span t-field="o.amount_tax" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td></tr>
                                <tr class="pt-total"><td>Total TTC</td><td><span t-field="o.amount_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td></tr>
                                <tr><td>Règlements enregistrés</td><td><span t-field="o.primetech_amount_paid" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td></tr>
                                <tr class="pt-balance"><td>Reste à payer</td><td><span t-field="o.amount_residual" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td></tr>
                            </table>
                        </div>
                        <div class="pt-details">
                            <h4>Conditions et termes de paiement</h4>
                            <p t-if="o.invoice_payment_term_id"><strong>Conditions :</strong> <span t-field="o.invoice_payment_term_id.name"/></p>
                            <p t-if="o.preferred_payment_method_line_id"><strong>Mode de paiement :</strong> <span t-field="o.preferred_payment_method_line_id.name"/></p>
                            <p t-if="o.payment_reference"><strong>Référence de paiement :</strong> <span t-field="o.payment_reference"/></p>
                            <p t-if="o.partner_bank_id"><strong>Banque / compte :</strong> <span t-field="o.partner_bank_id.acc_number"/></p>
                        </div>
                        <div class="pt-note"><strong>Montant en lettres :</strong> <span t-esc="o.currency_id.amount_to_text(o.amount_total)"/></div>

                        <t t-set="payments" t-value="o._primetech_payment_details()"/>
                        <div class="pt-payments" t-if="payments">
                            <h4>Règlements imputés à cette facture</h4>
                            <table><thead><tr><th>Date</th><th>Référence</th><th>Journal</th><th>Encaissé par</th><th style="text-align:right">Montant</th></tr></thead>
                                <tbody><tr t-foreach="payments" t-as="payment"><td t-esc="payment['date']"/><td t-esc="payment['reference']"/><td t-esc="payment['journal']"/><td t-esc="payment['collector']"/><td style="text-align:right"><span t-esc="payment['amount']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td></tr></tbody>
                            </table>
                        </div>
                        <div class="pt-terms">
                            <strong>Conditions générales :</strong> Tout règlement doit être effectué à l'échéance indiquée. En cas de retard, les conditions contractuelles et la réglementation applicable s'appliquent.
                        </div>
                        <div class="pt-signatures">
                            <div class="pt-signature"><strong>LA DIRECTION</strong><div class="pt-sign-box"/></div>
                            <div class="pt-signature"><strong><t t-if="is_customer">LE CLIENT</t><t t-else="">LE FOURNISSEUR</t></strong><div class="pt-sign-box"/></div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_primetech_customer_invoice"><t t-call="primetech_supplier_invoice_logistics.report_primetech_invoice_document"/></template>
    <template id="report_primetech_supplier_invoice"><t t-call="primetech_supplier_invoice_logistics.report_primetech_invoice_document"/></template>
</odoo>
