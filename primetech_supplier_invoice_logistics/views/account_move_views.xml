<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_primetech_supplier_logistics" model="ir.ui.view">
        <field name="name">account.move.form.primetech.supplier.logistics</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <!-- Keep Odoo's native confirmation button and provide a separate
                 reception action for supplier bills. -->
            <xpath expr="(//header/button[@name='action_post'])[2]" position="before">
                <button name="action_create_primetech_receipt" string="R&#233;ceptionner" class="oe_highlight"
                        type="object" icon="fa-truck" groups="account.group_account_invoice"
                        invisible="move_type != 'in_invoice' or state != 'draft' or primetech_receipt_picking_count &gt; 0"/>
                <button name="action_create_primetech_delivery" string="Cr&#233;er la livraison" class="oe_highlight"
                        type="object" icon="fa-truck" groups="account.group_account_invoice"
                        invisible="move_type != 'out_invoice' or state != 'draft' or primetech_delivery_picking_count &gt; 0"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']" position="attributes">
                <attribute name="class">pt-supplier-bill-lines</attribute>
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='asset_category_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_uom_id' and @groups]" position="attributes">
                <attribute name="string">Unité de mesure</attribute>
                <attribute name="optional">show</attribute>
                <attribute name="groups">base.group_user</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="attributes">
                <attribute name="string">Article</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='name']" position="attributes">
                <attribute name="string">Libellé</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='account_id']" position="attributes">
                <attribute name="string">Compte comptable</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='asset_category_id']" position="attributes">
                <attribute name="string">Catégorie d’actif</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='discount']" position="attributes">
                <attribute name="string">Remise (%)</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='tax_ids']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="attributes">
                <attribute name="string">Prix unitaire</attribute>
                <attribute name="widget">monetary</attribute>
                <attribute name="digits">[16, 3]</attribute>
                <attribute name="options">{'currency_field': 'currency_id', 'field_digits': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='account_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_create_primetech_receipt" type="object" class="oe_stat_button" icon="fa-truck"
                        string="Cr&#233;er la r&#233;ception"
                        invisible="move_type != 'in_invoice' or state != 'posted' or primetech_receipt_picking_count &gt; 0"/>
                <button name="action_view_primetech_receipts" type="object" class="oe_stat_button" icon="fa-truck" invisible="move_type != 'in_invoice' or primetech_receipt_picking_count == 0">
                    <field name="primetech_receipt_picking_count" widget="statinfo" string="R&#233;ceptions"/>
                </button>
                <button name="action_view_primetech_deliveries" type="object" class="oe_stat_button" icon="fa-truck" invisible="move_type != 'out_invoice' or primetech_delivery_picking_count == 0">
                    <field name="primetech_delivery_picking_count" widget="statinfo" string="Livraisons"/>
                </button>
            </xpath>
            <!-- Complete the native supplier-bill header on the left. -->
            <xpath expr="//group[@id='header_left_group']/field[@name='ref'][1]" position="after">
                <field name="payment_reference" string="Référence du paiement"
                       invisible="move_type != 'in_invoice'" readonly="inalterable_hash != False"/>
                <field name="preferred_payment_method_line_id" string="Mode de paiement"
                       invisible="move_type != 'in_invoice'"/>
                <field name="partner_bank_id" string="Compte bancaire destinataire"
                       context="{'default_partner_id': bank_partner_id, 'display_account_trust': True}"
                       domain="[('partner_id', '=', bank_partner_id)]"
                       invisible="move_type != 'in_invoice'" readonly="is_move_sent and state != 'draft'"/>
                <field name="primetech_weight_rate" string="Taux poids"
                       invisible="move_type != 'in_invoice'" readonly="state != 'draft'"/>
                <field name="primetech_volume_rate" string="Taux volume"
                       invisible="move_type != 'in_invoice'" readonly="state != 'draft'"/>
            </xpath>
            <!-- Essential customer details, displayed directly below the customer on sales invoices. -->
            <xpath expr="//group[@id='header_left_group']//field[@name='partner_id']" position="after">
                <div class="pt-customer-invoice-contact"
                     invisible="move_type not in ('out_invoice', 'out_refund') or not partner_id">
                    <field name="primetech_customer_address" nolabel="1" readonly="1"
                           widget="text" placeholder="Adresse client"
                           invisible="not primetech_customer_address"/>
                    <div class="pt-customer-contact-row">
                        <span class="fa fa-phone" title="Téléphone"/>
                        <field name="primetech_customer_phone" nolabel="1" readonly="1"
                               placeholder="Téléphone" invisible="not primetech_customer_phone"/>
                        <span class="fa fa-mobile" title="Mobile" invisible="not primetech_customer_mobile"/>
                        <field name="primetech_customer_mobile" nolabel="1" readonly="1"
                               placeholder="Mobile" invisible="not primetech_customer_mobile"/>
                    </div>
                    <div class="pt-customer-contact-row">
                        <span class="fa fa-id-card-o" title="NIU / N° TVA" invisible="not primetech_customer_vat"/>
                        <field name="primetech_customer_vat" nolabel="1" readonly="1"
                               placeholder="NIU / N° TVA" invisible="not primetech_customer_vat"/>
                        <span class="fa fa-envelope-o" title="E-mail" invisible="not primetech_customer_email"/>
                        <field name="primetech_customer_email" nolabel="1" readonly="1"
                               placeholder="E-mail" invisible="not primetech_customer_email"/>
                    </div>
                </div>
            </xpath>
            <!-- These two standard fields are displayed in the left supplier header above. -->
            <xpath expr="//group[@id='header_right_group']/field[@name='payment_reference']" position="attributes">
                <attribute name="invisible">move_type in ('in_invoice', 'in_refund')</attribute>
            </xpath>
            <xpath expr="//group[@id='header_right_group']/field[@name='partner_bank_id']" position="attributes">
                <attribute name="invisible">move_type in ('in_invoice', 'in_refund')</attribute>
            </xpath>
            <!-- Reuse Odoo's native automatic-entry field: one field only. -->
            <xpath expr="//label[@name='invoice_vendor_bill_id_label']" position="attributes">
                <attribute name="string">Saisie automatique</attribute>
            </xpath>
            <xpath expr="//group[@id='header_left_group']/field[@name='invoice_vendor_bill_id' and contains(@class, 'oe_edit_only')]" position="attributes">
                <attribute name="invisible">state != 'draft' or move_type != 'in_invoice'</attribute>
                <attribute name="placeholder">Sélectionner un bon de commande ou une ancienne facture</attribute>
            </xpath>
            <!-- The supplier payment method is shown in the header, not twice in Other Info. -->
            <xpath expr="//group[@name='accounting_info_group']/field[@name='preferred_payment_method_line_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Supplier-bill logistics fields in the native right-hand header group. -->
            <xpath expr="//group[@id='header_right_group']/field[@name='invoice_date'][2]" position="after">
                <field name="primetech_apply_discount"
                       invisible="move_type not in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund')"
                       readonly="state != 'draft'"/>
                <field name="primetech_warehouse_id" invisible="move_type != 'in_invoice'" readonly="state != 'draft'"/>
                <field name="primetech_picking_type_id" invisible="move_type != 'in_invoice'" readonly="state != 'draft'"/>
                <field name="primetech_stock_location_id" invisible="move_type != 'in_invoice'" readonly="state != 'draft'"/>
                <field name="primetech_delivery_warehouse_id" invisible="move_type != 'out_invoice'" readonly="state != 'draft'"/>
                <field name="primetech_delivery_picking_type_id" invisible="move_type != 'out_invoice'" readonly="state != 'draft'"/>
                <field name="primetech_delivery_stock_location_id" invisible="move_type != 'out_invoice'" readonly="state != 'draft'"/>
            </xpath>
            <xpath expr="//group[contains(@class, 'oe_subtotal_footer')][1]" position="attributes">
                <attribute name="invisible">move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt') or payment_state == 'invoicing_legacy' or (move_type in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund') and primetech_apply_discount)</attribute>
            </xpath>
            <xpath expr="//group[contains(@class, 'oe_subtotal_footer')][1]" position="after">
                <group class="oe_subtotal_footer" colspan="4"
                       invisible="move_type not in ('in_invoice', 'in_refund', 'out_invoice', 'out_refund') or not primetech_apply_discount">
                    <field name="primetech_discount_account_id" invisible="move_type in ('out_invoice', 'out_refund')" readonly="state != 'draft'"/>
                    <field name="primetech_discount_type" readonly="state != 'draft'"/>
                    <field name="primetech_discount_value" readonly="state != 'draft'"/>
                    <field name="primetech_discount_amount" readonly="1"/>
                    <field name="primetech_amount_untaxed_after_discount" string="TOTAL HT" readonly="1"/>
                    <field name="primetech_amount_after_discount" string="Total" readonly="1" class="oe_subtotal_footer_separator"/>
                    <field name="primetech_total_margin" string="Marge totale" readonly="1"
                           class="oe_subtotal_footer_separator pt-invoice-total-margin"
                           invisible="move_type not in ('out_invoice', 'out_refund')"/>
                </group>
            </xpath>
            <xpath expr="//group[contains(@class, 'oe_subtotal_footer')][1]/field[@name='tax_totals']" position="after">
                <field name="primetech_total_margin" string="Marge totale" readonly="1"
                       class="oe_subtotal_footer_separator pt-invoice-total-margin"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
            <xpath expr="//group[@id='header_right_group']/div[@name='journal_div']" position="after">
                <field name="primetech_calculation_basis" invisible="move_type != 'in_invoice'" readonly="state != 'draft'"/>
            </xpath>
            <!-- Keep Odoo's unique native conversion widget and rename its label. -->
            <xpath expr="//div[@name='in_and_refresh_button_div']/div[1]" position="replace">
                <div invisible="move_type in ('out_invoice', 'out_refund')">Devise</div>
            </xpath>
            <xpath expr="//div[@name='in_and_refresh_button_div']" position="attributes">
                <attribute name="invisible">move_type == 'entry' or move_type in ('out_invoice', 'out_refund')</attribute>
            </xpath>
            <xpath expr="//div[@name='currency_div']" position="attributes">
                <attribute name="invisible">move_type == 'entry' or move_type in ('out_invoice', 'out_refund')</attribute>
            </xpath>
            <!-- Supplier bills display the invoice currency first: 1 USD = 675 FCFA.
                 Odoo's internal rate remains present but is managed by the
                 inverse field so accounting computations keep their standard behaviour. -->
            <xpath expr="//div[@name='currency_conversion_div']" position="replace">
                <div name="currency_conversion_div"
                     class="d-flex gap-1 text-muted"
                     invisible="move_type != 'in_invoice' or currency_id == company_currency_id">
                    <span>1</span>
                    <field name="currency_id" readonly="True" options="{'no_open': True}" class="w-auto"/>
                    <span>=</span>
                    <field name="primetech_display_exchange_rate" digits="[12,6]" readonly="state != 'draft'"/>
                    <field name="company_currency_id" readonly="True" options="{'no_open': True}" class="w-auto"/>
                    <field name="invoice_currency_rate" invisible="1"/>
                </div>
                <div name="currency_conversion_div_native"
                     class="d-flex gap-1 text-muted"
                     invisible="move_type == 'in_invoice' or currency_id == company_currency_id">
                    <span>1</span>
                    <field name="company_currency_id" readonly="True" options="{'no_open': True}" class="w-auto"/>
                    <span>=</span>
                    <field name="invoice_currency_rate" digits="[12,6]" readonly="state != 'draft'"/>
                    <field name="currency_id" readonly="True" options="{'no_open': True}" class="w-auto"/>
                </div>
            </xpath>
            <!-- Exact logistics-column order used by the supplier bill grid. -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="before">
                <!-- Ensures that Odoo formats Price and Dernier Prix with the
                     currency selected on the supplier bill. -->
                <field name="currency_id" column_invisible="1"/>
                <field name="primetech_last_price" widget="monetary"
                       options="{'currency_field': 'currency_id', 'field_digits': True}" digits="[16, 3]"
                       string="Dernier prix fournisseur" optional="show"
                       column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="after">
                <field name="company_currency_id" column_invisible="1"/>
                <field name="primetech_stock_quantity" string="Stock actuel" readonly="1" optional="show"/>
                <field name="primetech_last_real_price" string="Dernier prix réel" optional="show"
                       widget="monetary" options="{'currency_field': 'company_currency_id', 'field_digits': True}"
                       digits="[16, 3]" column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"/>
                <field name="primetech_real_price" string="Prix réel" optional="show" column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"/>
                <field name="primetech_weight_cost" string="Constante de poids" optional="show" column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"/>
                <field name="primetech_volume_cost" string="Constante de volume" optional="show" column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"/>
                <field name="primetech_cost_by_weight" string="Coût de revient par poids" optional="show" column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"/>
                <field name="primetech_cost_by_volume" string="Coût de revient par volume" optional="show" column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"/>
                <field name="primetech_last_final_purchase_cost" string="Dernier coût d’achat final" readonly="1" optional="show"
                       column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"/>
                <field name="primetech_final_cost" string="Coût de revient final" optional="show" column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"/>
                <field name="primetech_sale_cost" string="Coût" widget="monetary"
                       options="{'currency_field': 'currency_id'}" readonly="1"
                       column_invisible="parent.move_type not in ('out_invoice', 'out_refund')"/>
                <field name="primetech_line_margin" string="Marge totale" widget="monetary"
                       options="{'currency_field': 'currency_id'}" readonly="1"
                       column_invisible="parent.move_type not in ('out_invoice', 'out_refund')"/>
                <field name="primetech_sale_price_by_weight" string="Prix de vente par poids" optional="show" column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"/>
                <field name="primetech_sale_price_by_volume" string="Prix de vente par volume" optional="show" column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"/>
                <field name="primetech_last_final_sale_price" string="Dernier prix de vente final" optional="show" column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"/>
                <field name="primetech_final_sale_price" string="Prix de vente final" optional="show" column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"/>
                <field name="primetech_weight_manual" column_invisible="1" force_save="1"/>
                <field name="primetech_weight_is_manual" column_invisible="1" force_save="1"/>
                <field name="primetech_weight" string="Poids" optional="show" column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"/>
                <field name="primetech_volume_manual" column_invisible="1" force_save="1"/>
                <field name="primetech_volume_is_manual" column_invisible="1" force_save="1"/>
                <field name="primetech_volume" string="Volume" optional="show" column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"/>
                <field name="primetech_constant_cost" string="Constante" optional="hide" column_invisible="parent.move_type not in ('in_invoice', 'in_refund')"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="before">
                <field name="primetech_product_image" widget="image" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']" position="after">
                <group string="Totaux logistiques" invisible="move_type != 'in_invoice'">
                    <field name="primetech_total_units" string="Total unités" readonly="1" digits="[16,0]"/>
                    <field name="primetech_total_weight" string="Total poids (kg)" readonly="1" digits="[16,5]"/>
                    <field name="primetech_total_volume" string="Total volume (CBM)" readonly="1" digits="[16,5]"/>
                    <field name="primetech_total_cost" readonly="1"/>
                    <field name="primetech_total_constant" readonly="1"/>
                </group>
                <group string="Informations logistiques"
                       invisible="move_type not in ('out_invoice', 'out_refund')">
                    <field name="primetech_total_units" string="Total unités" readonly="1" digits="[16,0]"/>
                    <field name="primetech_total_cost" string="Coût total" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
