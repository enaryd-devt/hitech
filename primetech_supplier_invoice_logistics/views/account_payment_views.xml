<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_primetech_supplier_advance_payment_wizard" model="ir.ui.view">
        <field name="name">primetech.supplier.advance.payment.wizard.form</field>
        <field name="model">primetech.supplier.advance.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Ajouter un acompte fournisseur">
                <group>
                    <field name="invoice_id"/>
                    <field name="partner_id"/>
                    <field name="currency_id"/>
                    <field name="amount"/>
                    <field name="payment_date"/>
                    <field name="journal_id"/>
                    <field name="communication"/>
                </group>
                <footer>
                    <button name="action_create_payment" type="object" string="Comptabiliser l'acompte" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_account_payment_form_primetech_receipt" model="ir.ui.view">
        <field name="name">account.payment.form.primetech.receipt</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_draft']" position="before">
                <button name="action_print_primetech_payment_receipt" type="object" string="Imprimer le reçu"
                        class="btn-secondary" icon="fa-print" invisible="state not in ('in_process', 'paid')"/>
            </xpath>
            <xpath expr="//header/button[@name='action_draft']" position="attributes">
                <attribute name="groups">account.group_account_manager</attribute>
            </xpath>
        </field>
    </record>
</odoo>
