<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Same category makes this a single drop-down on the user access-rights form. -->
    <record id="module_category_primetech_supplier_invoice" model="ir.module.category">
        <field name="name">Factures fournisseurs logistiques</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_supplier_invoice_user" model="res.groups">
        <field name="name">Utilisateur</field>
        <field name="category_id" ref="module_category_primetech_supplier_invoice"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice')), (4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_supplier_invoice_product_manager" model="res.groups">
        <field name="name">Utilisateur avec gestion des articles</field>
        <field name="category_id" ref="module_category_primetech_supplier_invoice"/>
        <field name="implied_ids" eval="[(4, ref('group_supplier_invoice_user')), (4, ref('product.group_product_manager'))]"/>
    </record>

    <record id="group_supplier_invoice_administrator" model="res.groups">
        <field name="name">Administrateur</field>
        <field name="category_id" ref="module_category_primetech_supplier_invoice"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice')), (4, ref('account.group_account_manager')), (4, ref('stock.group_stock_user')), (4, ref('stock.group_stock_manager'))]"/>
    </record>
</odoo>
