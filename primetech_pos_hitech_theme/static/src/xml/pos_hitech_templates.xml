<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.Navbar" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[contains(@class, 'status-buttons')]" position="inside">
            <div class="primetech-pos-brand" title="Point de vente">
                <img t-attf-src="/web/image?model=res.company&amp;id={{pos.company.id}}&amp;field=logo" alt="Logo de l'entreprise"/>
            </div>
        </xpath>
        <xpath expr="//div[contains(@class, 'status-buttons')]/Dropdown" position="before">
            <div class="primetech-live-clock" t-if="!ui.isSmall" title="Heure locale">
                <i class="fa fa-clock-o"/>
                <span t-esc="hitechCurrentTime"/>
            </div>
            <button class="primetech-theme-toggle" t-on-click="toggleHitechDarkMode" t-att-title="hitechDarkMode ? 'Passer en mode clair' : 'Passer en mode sombre'" t-att-aria-label="hitechDarkMode ? 'Passer en mode clair' : 'Passer en mode sombre'">
                <i t-att-class="hitechDarkMode ? 'fa fa-sun-o' : 'fa fa-moon-o'"/>
            </button>
        </xpath>
        <xpath expr="//div[contains(@class, 'status-buttons')]/Input" position="after">
            <button t-if="pos.showSearchButton()" class="primetech-reload-products" t-att-class="{'is-loading': hitechCatalogReloading}" t-att-disabled="hitechCatalogReloading" t-on-click="reloadProductCatalog" title="Recharger la liste des articles" aria-label="Recharger la liste des articles">
                <i t-att-class="hitechCatalogReloading ? 'fa fa-refresh fa-spin' : 'fa fa-refresh'"/>
                <span class="d-none d-xl-inline">Recharger</span>
            </button>
        </xpath>
        <xpath expr="//div[contains(@class, 'pos-centerheader')]" position="inside">
            <button t-if="!pos.primetechIsSeller()" class="primetech-active-orders" t-on-click="() => this.pos.showScreen('TicketScreen')" title="Afficher les commandes actives">
                <i class="fa fa-shopping-bag"/>
                <span>Commandes actives</span>
                <b t-esc="orderCount"/>
            </button>
        </xpath>
    </t>

    <t t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension" owl="1">
        <xpath expr="//CategorySelector" position="before">
            <div class="primetech-product-toolbar">
                <div class="primetech-product-title">
                    <h2>Produits</h2>
                    <span><t t-esc="productsToDisplay.length"/> articles</span>
                </div>
                <div class="primetech-sort-hint d-none d-xl-flex">
                    <span>Trier par :</span>
                    <div class="primetech-sort-options">
                        <button t-on-click="() => this.setHitechSort('recent')" t-att-class="{'active': hitechSort === 'recent'}">Plus récents</button>
                        <button t-on-click="() => this.setHitechSort('name')" t-att-class="{'active': hitechSort === 'name'}">Nom</button>
                        <button t-on-click="() => this.setHitechSort('price')" t-att-class="{'active': hitechSort === 'price'}">Prix</button>
                    </div>
                </div>
            </div>
        </xpath>
        <xpath expr="//OrderSummary" position="before">
            <div class="primetech-cart-heading">
                <span><i class="fa fa-shopping-cart me-2"/>Panier</span>
                <div class="primetech-cart-actions">
                    <small><t t-esc="currentOrder.totalQuantity || 0"/> article(s)</small>
                    <button t-if="currentOrder.lines.length" class="primetech-clear-cart" t-on-click="clearHitechCart" title="Vider entièrement le panier">
                        <i class="fa fa-trash-o"/><span>Vider</span>
                    </button>
                </div>
            </div>
        </xpath>
        <xpath expr="//button[contains(@class, 'pay-button')]" position="replace">
            <button t-if="!pos.scanning and pos.primetechIsSeller()" class="btn-switchpane pay-button btn btn-lg flex-fill btn-secondary" disabled="disabled" title="Le paiement est réservé à l'utilisateur POS">
                <span class="d-block">Paiement</span>
                <span t-esc="total" />
            </button>
            <button t-if="!pos.scanning and pos.primetechIsSeller()" class="btn-switchpane btn btn-lg flex-fill btn-primary" t-att-disabled="currentOrder.is_empty()" t-on-click="() => pos.primetechSendOrder()">
                <span class="d-block">Envoyer</span>
                <span t-esc="total" />
            </button>
            <button t-if="!pos.scanning and !pos.primetechIsSeller()" class="btn-switchpane pay-button btn btn-lg w-50" t-attf-class="{{ currentOrder.is_empty() ? 'btn-secondary' : 'btn-primary' }}" t-on-click="() => pos.pay()">
                <span class="d-block">Pay</span>
                <span t-esc="total" />
            </button>
        </xpath>
        <xpath expr="//button[contains(@class, 'review-button')]" position="attributes">
            <attribute name="t-att-class">pos.primetechIsSeller() ? 'btn-switchpane btn btn-secondary review-button flex-fill' : 'btn-switchpane btn btn-secondary review-button w-50'</attribute>
        </xpath>
    </t>

    <t t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension" owl="1">
        <xpath expr="//button[contains(@class, 'pay-order-button')]" position="replace">
            <button t-if="pos.primetechIsSeller()" class="pay-order-button button btn btn-secondary btn-lg py-3 d-flex align-items-center justify-content-center flex-fill" disabled="disabled" title="Le paiement est réservé à l'utilisateur POS">Paiement</button>
            <button t-if="pos.primetechIsSeller()" class="button btn btn-primary btn-lg py-3 d-flex align-items-center justify-content-center flex-fill" t-on-click="() => pos.primetechSendOrder()">Envoyer</button>
            <button t-if="!pos.primetechIsSeller()" class="pay pay-order-button button btn btn-primary btn-lg py-3 d-flex align-items-center justify-content-center flex-fill" t-on-click="props.actionToTrigger" t-esc="props.actionName"/>
        </xpath>
    </t>

    <t t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension" owl="1">
        <xpath expr="//article" position="attributes">
            <attribute name="t-att-class">{'primetech-product-out-of-stock': props.product.is_storable &amp;&amp; !env.services.pos.primetechIsCashier() &amp;&amp; this.availableQuantity &lt;= 0}</attribute>
            <attribute name="t-on-click">(event) => props.product.is_storable &amp;&amp; !env.services.pos.primetechIsCashier() &amp;&amp; this.availableQuantity &lt;= 0 ? null : props.onClick(event)</attribute>
        </xpath>
        <xpath expr="//div[contains(@class, 'product-content')]" position="after">
            <div t-if="props.product.is_storable &amp;&amp; !this.primetechHideStockQuantity" class="primetech-stock-badge" t-att-class="{'is-empty': this.availableQuantity &lt;= 0, 'is-critical': this.primetechStockLevel === 'critical', 'is-warning': this.primetechStockLevel === 'warning', 'is-available': this.primetechStockLevel === 'available'}">
                <i class="fa fa-cubes me-1"/>
                <span t-esc="this.availableQuantity"/>
            </div>
            <div class="primetech-product-price">
                <t t-esc="env.services.pos.getProductPriceFormatted(props.product)"/>
                <button class="primetech-product-info" title="Voir les informations de l'article" t-on-click.stop="props.onProductInfoClick">
                    <i class="fa fa-info"/>
                </button>
            </div>
        </xpath>
    </t>

    <t t-inherit="point_of_sale.ProductInfoBanner" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[@t-if='this.props.product.is_storable']" position="attributes">
            <attribute name="t-if">this.props.product.is_storable &amp;&amp; this.pos.primetechCanViewStockQuantities()</attribute>
        </xpath>
        <xpath expr="//AccordionItem" position="attributes">
            <attribute name="t-if">this.pos.primetechCanViewStockQuantities() &amp;&amp; state.other_warehouses.length &gt; 0</attribute>
        </xpath>
    </t>

    <t t-inherit="point_of_sale.ProductInfoPopup" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[contains(@class, 'section-inventory')]" position="attributes">
            <attribute name="t-if">pos.primetechCanViewStockQuantities() &amp;&amp; !isVariant &amp;&amp; props.info.productInfo.warehouses.length &gt; 0</attribute>
        </xpath>
    </t>

    <t t-inherit="point_of_sale.CategorySelector" t-inherit-mode="extension" owl="1">
        <xpath expr="//t[@t-foreach='props.categories']" position="before">
            <button class="category-button primetech-category-all px-2 btn d-flex align-items-center rounded-3" t-att-class="{'primetech-category-active': primetechAllCategoriesSelected}" t-on-click="() => props.onClick(0)">
                <i class="fa fa-th-large me-1"/>
                <span class="text-wrap-categ text-center">Tous</span>
            </button>
        </xpath>
        <xpath expr="//t[@t-foreach='props.categories']/button" position="attributes">
            <attribute name="t-att-class">{'opacity-50': !category.isChildren &amp;&amp; !category.isSelected, 'justify-content-center': ui.isSmall, 'primetech-category-active': category.isSelected}</attribute>
        </xpath>
    </t>

    <t t-inherit="point_of_sale.Chrome" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[contains(@class, 'pos-content')]" position="after">
            <footer class="primetech-pos-footer">
                <button t-if="pos.mainScreen.component &amp;&amp; pos.mainScreen.component.name === 'ProductScreen'" class="primetech-new-order" t-on-click="() => pos.add_new_order()" title="Créer une nouvelle commande">
                    <i class="fa fa-plus"/>
                </button>
                <div class="primetech-open-orders">
                    <button t-foreach="pos.get_open_orders()" t-as="order" t-key="order.uuid" class="primetech-order-chip" t-att-class="{'is-active': pos.get_order() &amp;&amp; order.uuid === pos.get_order().uuid}" t-on-click="() => { pos.set_order(order); pos.showScreen('ProductScreen'); }" title="Ouvrir cette commande">
                        <div class="primetech-order-chip-head">
                            <b t-esc="order.pos_reference || order.name || 'Commande'"/>
                            <span title="Commande en cours"><i class="fa fa-circle"/></span>
                        </div>
                        <strong t-esc="env.utils.formatCurrency(order.get_total_with_tax())"/>
                        <small><i class="fa fa-shopping-basket me-1"/><t t-esc="order.totalQuantity || order.lines.length"/> article(s)</small>
                        <button class="primetech-delete-order" t-if="!order.finalized" t-on-click.stop="() => pos.onDeleteOrder(order)" title="Supprimer cette commande" aria-label="Supprimer cette commande">
                            <i class="fa fa-trash"/>
                        </button>
                        <i class="fa fa-chevron-right"/>
                    </button>
                </div>
                <span class="primetech-footer-status"><i class="fa fa-circle text-success me-2"/>Connecté</span>
                <span class="primetech-footer-location"><i class="fa fa-cubes me-2"/><b>Entrepôt de déstockage :</b><t t-esc="pos.pickingType.primetech_warehouse_name || 'Non défini'"/></span>
                <span class="primetech-footer-location"><i class="fa fa-building me-2"/><b>Point de vente :</b><t t-esc="pos.config.name"/></span>
            </footer>
        </xpath>
    </t>

    <!-- Full-width, print-friendly receipt.  The sale data remains Odoo's standard data. -->
    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[contains(@class, 'pos-receipt')]" position="replace">
            <div class="pos-receipt primetech-hitech-receipt">
                <t t-set="company" t-value="props.data.headerData.company"/>
                <t t-set="taxTotals" t-value="props.data.taxTotals"/>

                <header class="primetech-receipt-header">
                    <div class="primetech-receipt-company">
                        <img t-attf-src="/web/image?model=res.company&amp;id={{company.id}}&amp;field=logo" alt="Logo" class="primetech-receipt-logo"/>
                        <strong t-if="company.name" t-esc="company.name"/>
                        <span t-if="company.street" t-esc="company.street"/>
                        <span t-if="company.city" t-esc="company.city"/>
                        <span t-if="company.phone">Tél. : <t t-esc="company.phone"/></span>
                        <span t-if="company.email" t-esc="company.email"/>
                    </div>
                    <div class="primetech-receipt-meta">
                        <h2>TICKET DE VENTE</h2>
                        <strong>N° : <t t-esc="props.data.headerData.trackingNumber or props.data.name"/></strong>
                        <span t-esc="props.data.date"/>
                        <span>Vendu par : <t t-esc="props.data.seller_name"/></span>
                        <span>Encaissé par : <t t-esc="props.data.cashier_name"/></span>
                        <span>Caisse : <t t-esc="props.data.pos_config_name"/></span>
                        <span>Référence : <t t-esc="props.data.name"/></span>
                    </div>
                </header>

                <table class="primetech-receipt-lines" t-if="props.data.orderlines?.length">
                    <thead>
                        <tr><th>#</th><th>DÉSIGNATION</th><th>QTÉ</th><th>P.U</th><th>MONTANT</th></tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="props.data.orderlines" t-as="line" t-key="line_index">
                            <td t-esc="line_index + 1"/>
                            <td><strong t-esc="line.productName"/><small t-if="line.unit" t-esc="line.unit"/></td>
                            <td t-esc="line.qty"/>
                            <td t-esc="primetechUnitPriceWithoutCurrency(line.unitPrice)"/>
                            <td><strong t-esc="line.price"/></td>
                        </tr>
                    </tbody>
                </table>

                <section class="primetech-receipt-summary">
                    <div><span>Sous-total</span><strong t-esc="props.formatCurrency(taxTotals.order_sign * taxTotals.order_total)"/></div>
                    <div t-if="props.data.total_discount"><span>Remise</span><strong t-esc="props.formatCurrency(props.data.total_discount)"/></div>
                    <div t-if="taxTotals.has_tax_groups"><span>TVA</span><strong t-esc="props.formatCurrency(props.data.amount_tax)"/></div>
                </section>

                <section class="primetech-receipt-total">
                    <span t-if="props.data.is_paid">TOTAL PAYÉ</span>
                    <span t-elif="props.data.amount_due and props.data.amount_due &gt; 0">RESTE À PAYER</span>
                    <span t-else="">TOTAL À PAYER</span>
                    <strong t-esc="props.formatCurrency(taxTotals.order_sign * taxTotals.order_total)"/>
                </section>

                <section class="primetech-receipt-payment" t-if="props.data.paymentlines?.length">
                    <h3>MODE DE PAIEMENT</h3>
                    <div t-foreach="props.data.paymentlines" t-as="line" t-key="line_index">
                        <span t-esc="line.name"/><strong t-esc="props.formatCurrency(line.amount)"/>
                    </div>
                </section>

                <footer class="primetech-receipt-footer">
                    <strong>Merci de votre confiance</strong>
                    <span>Conservez ce ticket comme justificatif</span>
                    <span t-if="props.data.footer" t-esc="props.data.footer"/>
                    <span t-esc="props.data.name"/>
                    <span t-esc="props.data.date"/>
                </footer>
            </div>
        </xpath>
    </t>

</templates>
