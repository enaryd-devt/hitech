<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.primetech.pos.hitech</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='manual_discount']" position="after">
                <setting id="primetech_pos_price_authorization" string="Modification des prix" help="Seuls les employés sélectionnés pourront modifier un prix dans le point de vente.">
                    <div class="content-group">
                        <field name="pos_primetech_authorized_employee_ids" widget="many2many_tags" placeholder="Sélectionnez les employés autorisés"/>
                    </div>
                </setting>
                <setting id="primetech_pos_stock_alerts" string="Niveaux d'alerte de stock au POS" help="Définissez les niveaux de couleur des quantités visibles sur les articles.">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="pos_primetech_stock_warning_level" class="col-lg-4 o_light_label">Seuil d'alerte (orange)</label>
                            <field name="pos_primetech_stock_warning_level" class="col-lg-3"/>
                        </div>
                        <div class="row mt8">
                            <label for="pos_primetech_stock_critical_level" class="col-lg-4 o_light_label">Seuil critique (rouge)</label>
                            <field name="pos_primetech_stock_critical_level" class="col-lg-3"/>
                        </div>
                    </div>
                </setting>
                <setting id="primetech_pos_negative_stock" string="Vente en stock négatif" help="Autorisez des employés précis à enregistrer une vente lorsque le stock de l'entrepôt de ce POS est insuffisant.">
                    <field name="pos_primetech_allow_negative_stock_sale"/>
                    <div class="content-group mt16" invisible="not pos_primetech_allow_negative_stock_sale">
                        <field name="pos_primetech_negative_stock_authorized_employee_ids" widget="many2many_tags" placeholder="Sélectionnez les employés autorisés"/>
                    </div>
                </setting>
                <setting id="primetech_pos_order_sequence" string="Numérotation des commandes" help="Personnalisez le préfixe et le compteur quotidien de cette caisse. Utilisez un préfixe différent pour chaque caisse.">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="pos_primetech_order_reference_prefix" class="col-lg-4 o_light_label">Préfixe</label>
                            <field name="pos_primetech_order_reference_prefix" class="col-lg-3" placeholder="COM"/>
                        </div>
                        <div class="row mt8">
                            <label for="pos_primetech_order_sequence_padding" class="col-lg-4 o_light_label">Chiffres du compteur</label>
                            <field name="pos_primetech_order_sequence_padding" class="col-lg-3"/>
                        </div>
                        <div class="text-muted mt8">Format : Préfixe + AAMMJJ + compteur quotidien. Exemple : C1 + 260930 + 0001.</div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
