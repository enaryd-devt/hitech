<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_primetech_mobile_money_report_wizard_form" model="ir.ui.view">
        <field name="name">primetech.mobile.money.report.wizard.form</field>
        <field name="model">primetech.mobile.money.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Rapport Mobile Money">
                <group>
                    <group><field name="date_from"/><field name="date_to"/></group>
                    <group><field name="wallet_ids" widget="many2many_tags"/><field name="operation"/><field name="employee_ids" widget="many2many_tags"/></group>
                </group>
                <footer>
                    <button name="action_print_report" type="object" string="Imprimer le rapport" class="btn-primary" icon="fa-print"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_primetech_mobile_money_report_wizard" model="ir.actions.act_window">
        <field name="name">Imprimer le rapport Mobile Money</field>
        <field name="res_model">primetech.mobile.money.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/>
    </record>
    <menuitem id="menu_primetech_mobile_money_report" name="Rapport" parent="menu_primetech_mobile_money_root" action="action_primetech_mobile_money_report_wizard" sequence="20" groups="point_of_sale.group_pos_manager"/>
</odoo>
