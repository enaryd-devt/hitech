<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="access_primetech_mobile_money_statement_line_manager" model="ir.model.access">
        <field name="name">primetech.mobile.money.statement.line.manager</field>
        <field name="model_id" ref="account.model_account_bank_statement_line"/>
        <field name="group_id" ref="point_of_sale.group_pos_manager"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    <record id="access_primetech_mobile_money_report_wizard_manager" model="ir.model.access">
        <field name="name">primetech.mobile.money.report.wizard.manager</field>
        <field name="model_id" ref="model_primetech_mobile_money_report_wizard"/>
        <field name="group_id" ref="point_of_sale.group_pos_manager"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
    <record id="group_pos_seller" model="res.groups">
        <field name="name">Vendeur POS</field>
        <field name="category_id" ref="base.module_category_sales_point_of_sale"/>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
        <field name="comment">Peut préparer et envoyer les commandes à encaisser, sans accéder au paiement.</field>
    </record>
    <record id="group_pos_cashier" model="res.groups">
        <field name="name">Caissier POS</field>
        <field name="category_id" ref="base.module_category_sales_point_of_sale"/>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
        <field name="comment">Peut recevoir les commandes envoyées, encaisser les paiements et imprimer les tickets.</field>
    </record>
</odoo>
