<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_report_primetech_mobile_money_ticket" model="ir.actions.report">
        <field name="name">Ticket Mobile Money</field><field name="model">account.bank.statement.line</field>
        <field name="report_type">qweb-pdf</field><field name="report_name">primetech_pos_hitech_theme.mobile_money_ticket</field>
        <field name="binding_model_id" ref="account.model_account_bank_statement_line"/><field name="binding_type">report</field><field name="multi">True</field>
    </record>
    <template id="mobile_money_ticket">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><t t-call="web.external_layout"><div class="page">
            <h2>Transaction Mobile Money</h2><p><b>Référence :</b> <span t-esc="doc.payment_ref"/></p>
            <p><b>Date :</b> <span t-field="doc.date"/> — <b>Servi par :</b> <span t-field="doc.primetech_mobile_money_employee_id"/></p>
            <table class="table table-sm"><tr><th>Mode de paiement</th><td t-field="doc.primetech_mobile_money_payment_method_id"/></tr><tr><th>Portefeuille</th><td t-field="doc.primetech_mobile_money_provider"/></tr><tr><th>Opération</th><td t-field="doc.primetech_mobile_money_operation"/></tr><tr t-if="doc.primetech_mobile_money_reason"><th>Motif / téléphone</th><td t-esc="doc.primetech_mobile_money_reason"/></tr></table>
            <h3>Montant : <span t-field="doc.amount"/></h3>
        </div></t></t></t>
    </template>
    <record id="action_report_primetech_mobile_money_global" model="ir.actions.report">
        <field name="name">Rapport global Mobile Money</field><field name="model">account.bank.statement.line</field>
        <field name="report_type">qweb-pdf</field><field name="report_name">primetech_pos_hitech_theme.mobile_money_global</field>
        <field name="binding_model_id" ref="account.model_account_bank_statement_line"/><field name="binding_type">report</field><field name="multi">True</field>
    </record>
    <template id="mobile_money_global">
        <t t-call="web.html_container"><t t-call="web.external_layout"><div class="page">
            <h2>Analyse des transactions Mobile Money</h2>
            <p><b>Période :</b> du <span t-esc="data.get('date_from')"/> au <span t-esc="data.get('date_to')"/> · <b>Caissier :</b> <span t-esc="data.get('employee')"/> · <b>Portefeuille :</b> <span t-esc="data.get('wallet')"/> · <b>Opération :</b> <span t-esc="data.get('operation')"/></p>
            <div class="row mt16 mb16"><div class="col-3"><strong>Transactions</strong><br/><span t-esc="data.get('total_count')"/></div><div class="col-3"><strong>Dépôts</strong><br/><span t-esc="formatLang(data.get('deposits', 0), currency_obj=docs[:1].company_currency_id)"/></div><div class="col-3"><strong>Retraits</strong><br/><span t-esc="formatLang(data.get('withdrawals', 0), currency_obj=docs[:1].company_currency_id)"/></div><div class="col-3"><strong>Solde net</strong><br/><span t-esc="formatLang(data.get('net', 0), currency_obj=docs[:1].company_currency_id)"/></div></div>
            <table class="table table-sm"><thead><tr><th>Date</th><th>Référence</th><th>Caissier</th><th>Mode</th><th>Portefeuille</th><th>Opération</th><th class="text-end">Montant</th></tr></thead><tbody>
                <tr t-foreach="docs" t-as="doc"><td t-field="doc.date"/><td t-esc="doc.payment_ref"/><td t-field="doc.primetech_mobile_money_employee_id"/><td t-field="doc.primetech_mobile_money_payment_method_id"/><td t-field="doc.primetech_mobile_money_provider"/><td t-field="doc.primetech_mobile_money_operation"/><td class="text-end" t-esc="formatLang(abs(doc.amount), currency_obj=doc.company_currency_id)"/></tr>
                <tr t-if="not docs"><td colspan="7" class="text-center">Aucune transaction pour les critères sélectionnés.</td></tr>
            </tbody></table>
        </div></t></t>
    </template>
</odoo>
