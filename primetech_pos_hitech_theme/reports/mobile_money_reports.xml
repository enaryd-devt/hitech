<?xml version="1.0" encoding="UTF-8"?>
<odoo>
 <record id="action_report_primetech_mobile_money_ticket" model="ir.actions.report"><field name="name">Ticket Mobile Money</field><field name="model">account.bank.statement.line</field><field name="report_type">qweb-pdf</field><field name="report_name">primetech_pos_hitech_theme.mobile_money_ticket</field><field name="binding_model_id" ref="account.model_account_bank_statement_line"/><field name="binding_type">report</field><field name="multi">True</field></record>
 <template id="mobile_money_ticket"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="company" t-value="o.company_id"/><t t-call="web.external_layout"><div class="page"><h2>Transaction Mobile Money</h2><p><b>Référence :</b> <span t-esc="o.payment_ref"/></p><p><b>Date :</b> <span t-field="o.date"/> — <b>Servi par :</b> <span t-field="o.primetech_mobile_money_employee_id"/></p><table class="table table-sm"><tr><th>Mode de paiement</th><td><span t-field="o.primetech_mobile_money_payment_method_id"/></td></tr><tr><th>Portefeuille</th><td><span t-field="o.primetech_mobile_money_provider"/></td></tr><tr><th>Opération</th><td><span t-field="o.primetech_mobile_money_operation"/></td></tr><tr t-if="o.primetech_mobile_money_reason"><th>Motif / téléphone</th><td t-esc="o.primetech_mobile_money_reason"/></tr></table><h3>Montant : <span t-field="o.amount"/></h3></div></t></t></t></template>
 <record id="action_report_primetech_mobile_money_global" model="ir.actions.report"><field name="name">Rapport global Mobile Money</field><field name="model">account.bank.statement.line</field><field name="report_type">qweb-pdf</field><field name="report_name">primetech_pos_hitech_theme.mobile_money_global</field><field name="binding_model_id" ref="account.model_account_bank_statement_line"/><field name="binding_type">report</field><field name="multi">True</field></record>
 <template id="mobile_money_global"><t t-call="web.html_container"><t t-set="o" t-value="docs[:1] or env['account.bank.statement.line'].new({'company_id': env.company.id})"/><t t-set="company" t-value="o.company_id"/><t t-call="web.external_layout"><div class="page"><h2>Analyse des transactions Mobile Money</h2><t t-if="data"><p><b>Période :</b> du <span t-esc="data.get('date_from', '')"/> au <span t-esc="data.get('date_to', '')"/> · <b>Caissier :</b> <span t-esc="data.get('employee', 'Tous les caissiers')"/> · <b>Portefeuille :</b> <span t-esc="data.get('wallet', 'Tous les portefeuilles')"/> · <b>Opération :</b> <span t-esc="data.get('operation', 'Toutes les opérations')"/></p><table class="table table-borderless table-sm"><tr><td><b>Transactions</b><br/><span t-esc="data.get('total_count', 0)"/></td><td><b>Dépôts</b><br/><span t-esc="data.get('deposits', 0)"/></td><td><b>Retraits</b><br/><span t-esc="data.get('withdrawals', 0)"/></td><td><b>Solde net</b><br/><span t-esc="data.get('net', 0)"/></td></tr></table></t><table class="table table-sm"><thead><tr><th>Date</th><th>Référence</th><th>Caissier</th><th>Mode</th><th>Portefeuille</th><th>Opération</th><th class="text-end">Montant</th></tr></thead><tbody><tr t-foreach="docs" t-as="line"><td><span t-field="line.date"/></td><td t-esc="line.payment_ref"/><td><span t-field="line.primetech_mobile_money_employee_id"/></td><td><span t-field="line.primetech_mobile_money_payment_method_id"/></td><td><span t-field="line.primetech_mobile_money_provider"/></td><td><span t-field="line.primetech_mobile_money_operation"/></td><td class="text-end"><span t-field="line.amount"/></td></tr><tr t-if="not docs"><td colspan="7" class="text-center">Aucune transaction pour les critères sélectionnés.</td></tr></tbody></table></div></t></t></template>
</odoo>
