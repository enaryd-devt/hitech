<?xml version="1.0" encoding="UTF-8"?>
<odoo>
 <record id="action_report_primetech_mobile_money_ticket" model="ir.actions.report"><field name="name">Ticket Mobile Money</field><field name="model">account.bank.statement.line</field><field name="report_type">qweb-pdf</field><field name="report_name">primetech_pos_hitech_theme.mobile_money_ticket</field><field name="binding_model_id" ref="account.model_account_bank_statement_line"/><field name="binding_type">report</field><field name="multi">True</field></record>
 <template id="mobile_money_ticket"><t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><t t-call="web.external_layout"><div class="page"><h2>Transaction Mobile Money</h2><p><b>Référence :</b> <span t-esc="doc.payment_ref"/></p><p><b>Date :</b> <span t-field="doc.date"/></p><p><b>Mode de paiement :</b> <span t-field="doc.primetech_mobile_money_payment_method_id"/></p><p><b>Portefeuille :</b> <span t-field="doc.primetech_mobile_money_provider"/></p><p><b>Opération :</b> <span t-field="doc.primetech_mobile_money_operation"/></p><h3>Montant : <span t-field="doc.amount"/></h3></div></t></t></t></template>
 <record id="action_report_primetech_mobile_money_global" model="ir.actions.report"><field name="name">Rapport global Mobile Money</field><field name="model">account.bank.statement.line</field><field name="report_type">qweb-pdf</field><field name="report_name">primetech_pos_hitech_theme.mobile_money_global</field><field name="binding_model_id" ref="account.model_account_bank_statement_line"/><field name="binding_type">report</field><field name="multi">True</field></record>
 <template id="mobile_money_global"><t t-call="web.html_container"><t t-call="web.external_layout"><div class="page"><h2>Rapport des dépôts et retraits Mobile Money</h2><p t-if="data and data.get('date_from')"><b>Période :</b> du <span t-esc="data.get('date_from')"/> au <span t-esc="data.get('date_to')"/></p><table class="table table-sm"><thead><tr><th>Date</th><th>Référence</th><th>Mode</th><th>Portefeuille</th><th>Opération</th><th>Montant</th></tr></thead><tbody><tr t-foreach="docs" t-as="doc"><td t-field="doc.date"/><td t-esc="doc.payment_ref"/><td t-field="doc.primetech_mobile_money_payment_method_id"/><td t-field="doc.primetech_mobile_money_provider"/><td t-field="doc.primetech_mobile_money_operation"/><td t-field="doc.amount"/></tr></tbody></table></div></t></t></template>
</odoo>
