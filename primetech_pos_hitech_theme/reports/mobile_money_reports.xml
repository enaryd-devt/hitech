<?xml version="1.0" encoding="UTF-8"?>
<odoo>
 <record id="action_report_primetech_mobile_money_ticket" model="ir.actions.report"><field name="name">Ticket Mobile Money</field><field name="model">account.bank.statement.line</field><field name="report_type">qweb-pdf</field><field name="report_name">primetech_pos_hitech_theme.mobile_money_ticket</field><field name="binding_model_id" ref="account.model_account_bank_statement_line"/><field name="binding_type">report</field><field name="multi">True</field></record>
 <template id="mobile_money_ticket"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="company" t-value="o.company_id"/><t t-call="web.external_layout"><div class="page"><h2>Transaction Mobile Money</h2><p><b>Référence :</b> <span t-esc="o.payment_ref"/></p><p><b>Date :</b> <span t-field="o.date"/> — <b>Servi par :</b> <span t-field="o.primetech_mobile_money_employee_id"/></p><table class="table table-sm"><tr><th>Mode de paiement</th><td><span t-field="o.primetech_mobile_money_payment_method_id"/></td></tr><tr><th>Portefeuille</th><td><span t-field="o.primetech_mobile_money_provider"/></td></tr><tr><th>Opération</th><td><span t-field="o.primetech_mobile_money_operation"/></td></tr><tr t-if="o.primetech_mobile_money_reason"><th>Motif / téléphone</th><td t-esc="o.primetech_mobile_money_reason"/></tr></table><h3>Montant : <span t-field="o.amount"/></h3></div></t></t></t></template>
 <record id="action_report_primetech_mobile_money_global" model="ir.actions.report"><field name="name">Rapport global Mobile Money</field><field name="model">account.bank.statement.line</field><field name="report_type">qweb-pdf</field><field name="report_name">primetech_pos_hitech_theme.mobile_money_global</field><field name="binding_model_id" ref="account.model_account_bank_statement_line"/><field name="binding_type">report</field><field name="multi">True</field></record>
 <template id="mobile_money_global"><t t-call="web.html_container"><t t-set="o" t-value="docs[:1] or env['account.bank.statement.line'].new({'company_id': env.company.id})"/><t t-set="company" t-value="o.company_id"/><t t-call="web.external_layout"><div class="page pt-mm-report"><style>.pt-mm-report{font-family:Arial,sans-serif;color:#15233c;font-size:10pt}.pt-mm-title{background:#075fc2;padding:11px 15px;margin:2px 0 12px}.pt-mm-meta{border:1px solid #d8e4f4;background:#f7faff;padding:9px 12px;margin-bottom:12px}.pt-mm-kpis{width:100%;border-collapse:separate;border-spacing:7px 0;margin:0 -7px 12px}.pt-mm-kpis td{width:25%;background:#f1f6fc;border-left:4px solid #0868c9;padding:9px}.pt-mm-kpis b{display:block;color:#5d6f87;font-size:8pt;text-transform:uppercase}.pt-mm-kpis strong{font-size:14pt;color:#07509a}.pt-mm-lines{width:100%;border-collapse:collapse}.pt-mm-lines th{background:#075fc2;color:#fff;padding:7px;text-align:left;font-size:8pt}.pt-mm-lines td{border-bottom:1px solid #dce6f2;padding:7px;vertical-align:top}.pt-mm-lines tr:nth-child(even){background:#f8fbff}.pt-mm-right{text-align:right}.pt-mm-sign{margin-top:24px;width:100%;font-size:9pt}.pt-mm-sign td{width:50%;padding-top:32px;text-align:center}.pt-mm-sign span{display:block;border-top:1px solid #7890ad;margin:0 25px;padding-top:5px}</style><div class="pt-mm-title"><h2 style="margin:0;color:#ffffff !important;font-size:19pt;">RAPPORT D'ANALYSE MOBILE MONEY</h2><p style="margin:3px 0 0;color:#ffffff !important;font-size:9pt;">Dépôts et retraits Orange Money / MTN MoMo</p></div><div class="pt-mm-meta"><b>Période :</b> du <span t-esc="data and data.get('date_from', '') or ''"/> au <span t-esc="data and data.get('date_to', '') or ''"/> | <b>Caissier :</b> <span t-esc="data and data.get('employee', 'Tous les caissiers') or 'Tous les caissiers'"/> | <b>Portefeuille :</b> <span t-esc="data and data.get('wallet', 'Tous les portefeuilles') or 'Tous les portefeuilles'"/><br/><b>Type :</b> <span t-esc="data and data.get('operation', 'Toutes les opérations') or 'Toutes les opérations'"/> | <b>Édité le :</b> <span t-esc="data and data.get('generated_at', '') or ''"/></div><table class="pt-mm-kpis"><tr><td><b>Transactions</b><strong t-esc="data and data.get('total_count', 0) or 0"/></td><td><b>Dépôts</b><strong t-esc="data and data.get('deposits', 0) or 0"/></td><td><b>Retraits</b><strong t-esc="data and data.get('withdrawals', 0) or 0"/></td><td><b>Solde net</b><strong t-esc="data and data.get('net', 0) or 0"/></td></tr></table><table class="pt-mm-lines"><thead><tr><th>Date</th><th>Référence / motif</th><th>Caissier</th><th>Portefeuille</th><th>Type</th><th class="pt-mm-right">Montant</th></tr></thead><tbody><tr t-foreach="docs" t-as="line"><td><span t-field="line.date"/></td><td t-esc="line.payment_ref"/><td><span t-field="line.primetech_mobile_money_employee_id"/></td><td><span t-field="line.primetech_mobile_money_payment_method_id"/></td><td><span t-field="line.primetech_mobile_money_operation"/></td><td class="pt-mm-right"><span t-field="line.amount"/></td></tr><tr t-if="not docs"><td colspan="6" class="text-center">Aucune transaction pour les critères sélectionnés.</td></tr></tbody></table><table class="pt-mm-sign"><tr><td><span>Établi par</span></td><td><span>Validé par</span></td></tr></table></div></t></t></template>
</odoo>
