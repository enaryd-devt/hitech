<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.primetech.currency.rate.auto</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='user_default_rights']" position="before">
                <block title="Taux de change internationaux" id="primetech_currency_rate_auto_settings">
                    <setting string="Actualiser automatiquement les taux" help="Import quotidien des taux de référence internationaux dans les devises actives d'Odoo.">
                        <field name="primetech_currency_rate_auto_enabled"/>
                        <div class="content-group mt16">
                            <button name="action_primetech_update_currency_rates" type="object" class="btn btn-secondary" icon="fa-refresh" string="Mettre à jour maintenant"/>
                            <div class="text-muted mt8">Source : Banque centrale européenne (BCE). EUR, XAF et XOF sont pris en charge, avec la parité CFA officielle.</div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
