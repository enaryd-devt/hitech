<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_primetech_currency_rate_auto" model="ir.ui.view">
        <field name="name">account.move.form.primetech.currency.rate.auto</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='currency_div']/div[@name='currency_conversion_div']" position="after">
                <div class="mt-1 text-end" name="primetech_currency_refresh_div">
                    <button name="action_primetech_refresh_invoice_currency_rate"
                            type="object"
                            icon="fa-refresh"
                            class="btn btn-primary btn-sm"
                            string="Recharger les taux"
                            invisible="move_type not in ('in_invoice', 'in_refund') or state != 'draft'"
                            title="Récupérer le taux international actuel de la devise sélectionnée"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
