<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="primetech_rh.Dashboard" owl="1">
    <div class="pt-rh-dashboard" t-ref="rhDashboardRoot">
      <header class="pt-rh-header">
        <div class="pt-rh-title"><span class="pt-rh-title-icon"><i class="fa fa-users"/></span><div><h1>Ressources Humaines</h1><p>Vue d’ensemble de vos équipes</p></div></div>
        <div class="pt-global-filters"><div class="pt-filter"><i class="fa fa-calendar"/><select t-model="state.filters.period" t-on-change="onFilterChange"><option value="today">Aujourd’hui</option><option value="week">Cette semaine</option><option value="month">Ce mois</option><option value="quarter">Ce trimestre</option><option value="semester">Ce semestre</option><option value="year">Cette année</option><option value="custom">Période personnalisée</option></select></div><t t-if="state.filters.period === 'custom'"><input class="pt-date" type="date" t-model="state.filters.date_from" t-on-change="onFilterChange"/><input class="pt-date" type="date" t-model="state.filters.date_to" t-on-change="onFilterChange"/></t><button class="pt-refresh" t-on-click="load"><i class="fa fa-refresh"/> Actualiser</button></div>
      </header>
      <div t-if="state.loading" class="pt-loading"><i class="fa fa-spinner fa-spin"/> Actualisation des indicateurs…</div>
      <t t-else="">
        <section class="pt-kpi-grid">
          <t t-if="can('employees')"><button class="pt-kpi blue" t-on-click="openEmployees"><i class="fa fa-users"/><strong t-esc="state.data.employees"/><span>Employés actifs</span></button><button class="pt-kpi mint" t-on-click="() => openContracts('recruitment')"><i class="fa fa-user-plus"/><strong t-esc="state.data.recruitments"/><span>Nouveaux employés</span></button></t>
          <t t-if="can('attendance')"><button class="pt-kpi purple" t-on-click="openAttendances"><i class="fa fa-check-circle"/><strong t-esc="state.data.attendance_employees"/><span>Présences moyennes</span></button><button class="pt-kpi coral" t-on-click="openAttendances"><i class="fa fa-clock-o"/><strong t-esc="state.data.attendance_hours"/><span>Heures travaillées</span></button></t>
          <t t-if="can('leaves')"><button class="pt-kpi rose" t-on-click="openAbsences"><i class="fa fa-exclamation-triangle"/><strong t-esc="state.data.absences"/><span>Absentéisme</span></button><button class="pt-kpi green" t-on-click="openLeaveToday"><i class="fa fa-calendar-check-o"/><strong t-esc="state.data.leave_today"/><span>Congés en cours</span></button><button class="pt-kpi cyan" t-on-click="openLeavePending"><i class="fa fa-calendar-o"/><strong t-esc="state.data.leave_pending"/><span>Demandes en attente</span></button></t>
          <t t-if="can('payroll')"><button class="pt-kpi gold" t-on-click="openPayslips"><i class="fa fa-money"/><strong t-esc="money(state.data.payroll)"/><span>Masse salariale nette</span></button><button class="pt-kpi violet" t-on-click="openPayslips"><i class="fa fa-file-text"/><strong t-esc="state.data.payroll_count"/><span>Bulletins générés</span></button></t>
        </section>
        <section class="pt-main-grid">
          <article t-if="can('employees')" class="pt-panel pt-workforce"><header><div><i class="fa fa-line-chart"/><h2>Évolution des effectifs</h2></div></header><div class="pt-chart-indicators"><button t-on-click="openEmployees"><small>Effectif actuel</small><b t-esc="chartLast(state.data.workforce_chart, 'total')"/></button><button t-on-click="() => openContracts('recruitment')"><small>Arrivées</small><b class="green" t-esc="chartSum(state.data.workforce_chart, 'arrivals')"/></button></div><div class="pt-curve-box"><svg viewBox="0 0 100 100" preserveAspectRatio="none"><polyline class="curve total" t-att-points="chartPoints(state.data.workforce_chart, 'total')"/><polyline class="curve arrivals" t-att-points="chartPoints(state.data.workforce_chart, 'arrivals')"/></svg></div></article>
          <article t-if="can('attendance')" class="pt-panel"><header><div><i class="fa fa-calendar-check-o"/><h2>Statut de présence</h2></div></header><div class="pt-donut-wrap"><div class="pt-donut attendance" t-att-style="'--rate:' + state.data.attendance_rate + '%' "><strong t-esc="state.data.attendance_rate + '%'"/><small>Taux de présence</small></div><div class="pt-legend"><p>Présents <strong t-esc="state.data.attendance_panel_count"/></p><p>Heures <strong t-esc="state.data.attendance_panel_hours"/></p></div></div></article>
          <article t-if="can('leaves')" class="pt-panel"><header><div><i class="fa fa-pie-chart"/><h2>Répartition des congés</h2></div></header><div class="pt-leave-list"><button t-foreach="state.data.leave_distribution" t-as="item" t-key="item.id" t-on-click="openAbsences"><span t-esc="item.name"/><b t-esc="item.days + ' j'"/></button><p t-if="!state.data.leave_distribution.length">Aucun congé validé sur cette période.</p></div></article>
        </section>
        <section class="pt-middle-grid">
          <article t-if="can('attendance')" class="pt-panel pt-table-panel"><header><div><i class="fa fa-id-card"/><h2>Dernières présences</h2></div><button t-on-click="openAttendances">Voir tout</button></header><table><thead><tr><th>Employé</th><th>Entrée</th><th>Statut</th></tr></thead><tbody><tr t-foreach="state.data.recent_attendance" t-as="item" t-key="item.id"><td t-esc="item.employee"/><td t-esc="item.check_in"/><td t-esc="item.status"/></tr></tbody></table></article>
          <article t-if="can('leaves')" class="pt-panel pt-table-panel"><header><div><i class="fa fa-calendar"/><h2>Demandes de congés récentes</h2></div><button t-on-click="openLeavePending">Voir tout</button></header><table><thead><tr><th>Employé</th><th>Type</th><th>Période</th></tr></thead><tbody><tr t-foreach="state.data.recent_leaves" t-as="item" t-key="item.id"><td t-esc="item.employee"/><td t-esc="item.type"/><td t-esc="item.period"/></tr></tbody></table></article>
          <article t-if="can('attendance')" class="pt-panel pt-arrivals"><header><div><i class="fa fa-exchange"/><h2>Indicateurs présences</h2></div></header><button class="pt-mini-kpi" t-on-click="openAttendanceOpen"><span>Pointages en cours</span><strong t-esc="state.data.attendance_open"/></button><button class="pt-mini-kpi" t-on-click="openAttendances"><span>Présences enregistrées</span><strong t-esc="state.data.attendance_count"/></button></article>
          <article t-if="can('employees')" class="pt-panel pt-departments"><header><div><i class="fa fa-th-large"/><h2>Employés par département</h2></div><button t-on-click="openEmployees">Voir tout</button></header><button t-foreach="state.data.distribution" t-as="item" t-key="item.name" class="pt-department" t-on-click="() => openDepartment(item)"><span t-esc="item.name"/><b t-esc="item.count"/></button></article>
        </section>
        <section class="pt-bottom-grid">
          <article class="pt-panel pt-actions"><header><div><i class="fa fa-bolt"/><h2>Actions rapides</h2></div></header><button t-if="can('employees')" class="primary" t-on-click="() => create('hr.employee', 'Nouveau collaborateur')"><i class="fa fa-user-plus"/> Nouveau collaborateur</button><button t-if="can('attendance')" t-on-click="() => create('hr.attendance', 'Nouveau pointage')"><i class="fa fa-sign-in"/> Nouveau pointage</button><button t-if="can('leaves')" t-on-click="() => create('hr.leave', 'Nouvelle demande de congé')"><i class="fa fa-calendar-plus-o"/> Demande de congé</button><button t-if="can('payroll')" t-on-click="() => create('hr.payslip', 'Nouveau bulletin')"><i class="fa fa-file-text"/> Nouveau bulletin</button></article>
          <article t-if="can('payroll')" class="pt-panel pt-payroll-panel"><header><div><i class="fa fa-bar-chart"/><h2>Masse salariale</h2></div></header><div class="pt-chart-indicators"><button t-on-click="openPayslips"><small>Net période</small><b t-esc="money(state.data.payroll_panel_total)"/></button><button t-on-click="openPayrollToProcess"><small>À traiter</small><b class="orange" t-esc="state.data.payroll_to_process"/></button></div><div class="pt-curve-box payroll"><svg viewBox="0 0 100 100" preserveAspectRatio="none"><polyline class="curve net" t-att-points="chartPoints(state.data.payroll_chart, 'net')"/></svg></div></article>
          <article t-if="can('payroll')" class="pt-panel pt-table-panel"><header><div><i class="fa fa-file-text"/><h2>Bulletins de paie récents</h2></div><button t-on-click="openPayslips">Voir tout</button></header><table><thead><tr><th>Employé</th><th>Période</th><th>Montant</th></tr></thead><tbody><tr t-foreach="state.data.recent" t-as="item" t-key="item.id"><td t-esc="item.employee"/><td t-esc="item.date"/><td t-esc="money(item.amount)"/></tr></tbody></table></article>
        </section>
      </t>
    </div>
  </t>
</templates>
