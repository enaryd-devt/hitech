<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_internal_reference" model="ir.ui.view">
        <field name="name">product.template.form.internal.reference</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="attributes">
                <attribute name="readonly">id and not primetech_can_change_category</attribute>
            </xpath>
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="primetech_can_change_category" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="primetech_auto_internal_reference" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="widget">primetech_rolling_code</attribute>
            </xpath>
            <xpath expr="//field[@name='barcode']" position="attributes">
                <attribute name="widget">primetech_barcode_generator</attribute>
            </xpath>
        </field>
    </record>
</odoo>
