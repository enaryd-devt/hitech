<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Technical groups: used by access rules and menus, never selected manually. -->
  <record id="group_reporting_dashboard" model="res.groups"><field name="name">Reporting technical - Dashboard</field><field name="category_id" eval="False"/></record>
  <record id="group_reporting_accounting" model="res.groups"><field name="name">Reporting technical - Accounting read</field><field name="category_id" eval="False"/></record>
  <record id="group_reporting_accounting_manager" model="res.groups"><field name="name">Reporting technical - Accounting manage</field><field name="category_id" eval="False"/><field name="implied_ids" eval="[(4, ref('group_reporting_accounting'))]"/></record>
  <record id="group_reporting_sales" model="res.groups"><field name="name">Reporting technical - Sales</field><field name="category_id" eval="False"/></record>
  <record id="group_reporting_purchase" model="res.groups"><field name="name">Reporting technical - Purchase read</field><field name="category_id" eval="False"/></record>
  <record id="group_reporting_purchase_manager" model="res.groups"><field name="name">Reporting technical - Purchase manage</field><field name="category_id" eval="False"/><field name="implied_ids" eval="[(4, ref('group_reporting_purchase'))]"/></record>
  <record id="group_reporting_stock" model="res.groups"><field name="name">Reporting technical - Stock read</field><field name="category_id" eval="False"/></record>
  <record id="group_reporting_stock_manager" model="res.groups"><field name="name">Reporting technical - Stock manage</field><field name="category_id" eval="False"/><field name="implied_ids" eval="[(4, ref('group_reporting_stock'))]"/></record>
  <record id="group_reporting_stock_shop" model="res.groups"><field name="name">Reporting technical - Shop stock</field><field name="category_id" eval="False"/><field name="implied_ids" eval="[(4, ref('group_reporting_stock'))]"/></record>
  <record id="group_reporting_hr" model="res.groups"><field name="name">Reporting technical - HR</field><field name="category_id" eval="False"/></record>
  <record id="group_reporting_validation" model="res.groups"><field name="name">Reporting technical - Legacy validation</field><field name="category_id" eval="False"/></record>
  <record id="group_reporting_manager" model="res.groups"><field name="name">Reporting technical - Full access</field><field name="category_id" eval="False"/><field name="implied_ids" eval="[(4, ref('group_reporting_dashboard')), (4, ref('group_reporting_accounting_manager')), (4, ref('group_reporting_sales')), (4, ref('group_reporting_purchase_manager')), (4, ref('group_reporting_stock_manager')), (4, ref('group_reporting_hr'))]"/></record>

  <!-- The six visible roles are exactly the six functional reporting menus. -->
  <record id="group_role_menu_dashboard" model="res.groups"><field name="name">Reporting : Tableau de bord</field><field name="category_id" ref="module_category_reporting_center"/><field name="implied_ids" eval="[(4, ref('group_reporting_dashboard'))]"/></record>
  <record id="group_role_menu_accounting" model="res.groups"><field name="name">Reporting : Comptabilite</field><field name="category_id" ref="module_category_reporting_center"/><field name="implied_ids" eval="[(4, ref('group_reporting_accounting_manager'))]"/></record>
  <record id="group_role_menu_sales" model="res.groups"><field name="name">Reporting : Ventes</field><field name="category_id" ref="module_category_reporting_center"/><field name="implied_ids" eval="[(4, ref('group_reporting_sales'))]"/></record>
  <record id="group_role_menu_purchase" model="res.groups"><field name="name">Reporting : Achats</field><field name="category_id" ref="module_category_reporting_center"/><field name="implied_ids" eval="[(4, ref('group_reporting_purchase_manager'))]"/></record>
  <record id="group_role_menu_stock" model="res.groups"><field name="name">Reporting : Stock et logistique</field><field name="category_id" ref="module_category_reporting_center"/><field name="implied_ids" eval="[(4, ref('group_reporting_stock_manager'))]"/></record>
  <record id="group_role_menu_hr" model="res.groups"><field name="name">Reporting : Ressources humaines</field><field name="category_id" ref="module_category_reporting_center"/><field name="implied_ids" eval="[(4, ref('group_reporting_hr'))]"/></record>

  <!-- Previous job-title profiles stay hidden so existing users retain their access. -->
  <record id="group_role_dg" model="res.groups"><field name="name">Legacy role - General manager</field><field name="category_id" eval="False"/><field name="implied_ids" eval="[(4, ref('group_reporting_manager'))]"/><field name="users" eval="[(4, ref('base.user_admin'))]"/></record>
  <record id="group_role_assistant_direction" model="res.groups"><field name="name">Legacy role - Assistant direction</field><field name="category_id" eval="False"/><field name="implied_ids" eval="[(4, ref('group_reporting_dashboard'))]"/></record>
  <record id="group_role_raf" model="res.groups"><field name="name">Legacy role - Finance</field><field name="category_id" eval="False"/><field name="implied_ids" eval="[(4, ref('group_reporting_accounting_manager'))]"/></record>
  <record id="group_role_comptable" model="res.groups"><field name="name">Legacy role - Accountant</field><field name="category_id" eval="False"/><field name="implied_ids" eval="[(4, ref('group_reporting_accounting'))]"/></record>
  <record id="group_role_controleur_gestion" model="res.groups"><field name="name">Legacy role - Controller</field><field name="category_id" eval="False"/><field name="implied_ids" eval="[(4, ref('group_reporting_dashboard')), (4, ref('group_reporting_accounting')), (4, ref('group_reporting_sales')), (4, ref('group_reporting_purchase')), (4, ref('group_reporting_stock'))]"/></record>
  <record id="group_role_directeur_exploitation" model="res.groups"><field name="name">Legacy role - Operations</field><field name="category_id" eval="False"/><field name="implied_ids" eval="[(4, ref('group_reporting_dashboard')), (4, ref('group_reporting_stock_manager')), (4, ref('group_reporting_sales')), (4, ref('group_reporting_purchase'))]"/></record>
  <record id="group_role_directeur_boutique" model="res.groups"><field name="name">Legacy role - Store manager</field><field name="category_id" eval="False"/><field name="implied_ids" eval="[(4, ref('group_reporting_stock_shop'))]"/></record>
  <record id="group_role_chef_rayon" model="res.groups"><field name="name">Legacy role - Department manager</field><field name="category_id" eval="False"/><field name="implied_ids" eval="[(4, ref('group_reporting_stock_shop'))]"/></record>
  <record id="group_role_caissiere" model="res.groups"><field name="name">Legacy role - Cashier</field><field name="category_id" eval="False"/><field name="implied_ids" eval="[(4, ref('group_reporting_stock'))]"/></record>
  <record id="group_role_supply_chain_manager" model="res.groups"><field name="name">Legacy role - Supply chain</field><field name="category_id" eval="False"/><field name="implied_ids" eval="[(4, ref('group_reporting_dashboard')), (4, ref('group_reporting_stock_manager')), (4, ref('group_reporting_purchase'))]"/></record>
  <record id="group_role_responsable_achats" model="res.groups"><field name="name">Legacy role - Purchase manager</field><field name="category_id" eval="False"/><field name="implied_ids" eval="[(4, ref('group_reporting_purchase_manager'))]"/></record>
  <record id="group_role_magasinier" model="res.groups"><field name="name">Legacy role - Warehouse manager</field><field name="category_id" eval="False"/><field name="implied_ids" eval="[(4, ref('group_reporting_stock'))]"/></record>
  <record id="group_role_responsable_informatique" model="res.groups"><field name="name">Legacy role - IT manager</field><field name="category_id" eval="False"/><field name="implied_ids" eval="[(4, ref('base.group_system')), (4, ref('group_reporting_manager'))]"/></record>

