<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="customer_delivery_pdf">
    <t t-call="web.html_container"><t t-call="web.external_layout"><div class="page">
      <h2>PRODUITS DÉSTOCKÉS / LIVRÉS</h2>
      <p><strong>Période :</strong> <t t-esc="wizard.date_from"/> au <t t-esc="wizard.date_to"/> — <strong>Société :</strong> <t t-esc="wizard.company_id.name"/></p>
      <div style="background:#eef7f8;border:1px solid #b9dfe3;padding:7px;margin-bottom:12px;"><strong>Entrepôt(s) d'étude :</strong> <t t-if="data.get('warehouse_names')"><t t-esc="', '.join(data['warehouse_names'])"/></t><t t-else="">Tous les entrepôts de la société</t></div>
      <h4 style="background:#0f4c5c;color:#fff;padding:9px;margin:0;">SYNTHÈSE PAR ARTICLE — STOCK À LA FIN DE PÉRIODE</h4>
      <table style="width:100%;border-collapse:collapse;margin-bottom:18px;"><thead><tr><th>Article</th><th style="text-align:right;">Quantité livrée</th><th style="text-align:right;">Stock restant</th></tr></thead><tbody><t t-foreach="data['summary']" t-as="item"><tr><td><t t-esc="item['product'].display_name"/></td><td style="text-align:right;"><t t-out="'{:,.2f}'.format(item['quantity'])"/></td><td style="text-align:right;font-weight:bold;"><t t-out="'{:,.2f}'.format(item['stock_remaining'])"/></td></tr></t></tbody></table>
      <h4 style="background:#0f4c5c;color:#fff;padding:9px;margin:0;">DÉTAIL DES LIVRAISONS CLIENTS</h4>
      <table style="width:100%;border-collapse:collapse;"><thead><tr><th>Date</th><th>Document</th><th>Client</th><th>Article</th><th style="text-align:right;">Qté livrée</th><th>UdM</th><th style="text-align:right;">Stock restant</th></tr></thead><tbody><t t-foreach="data['lines']" t-as="line"><tr><td><t t-out="line['date'].strftime('%d/%m/%Y') if line['date'] else ''"/></td><td><t t-esc="line['document']"/></td><td><t t-esc="line['customer']"/></td><td><t t-esc="line['product'].display_name"/></td><td style="text-align:right;"><t t-out="'{:,.2f}'.format(line['quantity'])"/></td><td><t t-esc="line['uom']"/></td><td style="text-align:right;"><t t-out="'{:,.2f}'.format(line['stock_remaining'])"/></td></tr></t></tbody></table>
      <t t-if="wizard.observations"><p><strong>Observations :</strong> <t t-esc="wizard.observations"/></p></t><style>th,td{border:1px solid #777;padding:5px;font-size:9px;}th{background:#d9eaf0;}</style>
    </div></t></t>
  </template>
</odoo>
