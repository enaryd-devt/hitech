<?xml version="1.0" encoding="utf-8"?>
<odoo><template id="customer_delivery_preview_template"><t t-call="web.external_layout"><div class="page p-4"><h2>Produits déstockés / livrés</h2><p><strong>Période :</strong> <t t-esc="wizard.date_from"/> au <t t-esc="wizard.date_to"/> — <t t-esc="wizard.company_id.name"/></p><div class="alert alert-info" role="status"><strong>Entrepôt(s) d'étude :</strong> <t t-if="data.get('warehouse_names')"><t t-esc="', '.join(data['warehouse_names'])"/></t><t t-else="">Tous les entrepôts de la société</t></div><h4 class="bg-primary text-white p-2">Synthèse par article — stock à la fin de période</h4><table class="table table-sm table-bordered"><thead><tr><th>Article</th><th class="text-end">Quantité livrée</th><th class="text-end">Stock restant</th></tr></thead><tbody><t t-foreach="data['summary']" t-as="item"><tr><td><t t-esc="item['product'].display_name"/></td><td class="text-end"><t t-out="'{:,.2f}'.format(item['quantity'])"/></td><td class="text-end fw-bold"><t t-out="'{:,.2f}'.format(item['stock_remaining'])"/></td></tr></t></tbody></table><h4 class="bg-primary text-white p-2">Détail des livraisons clients</h4><table class="table table-sm table-bordered"><thead><tr><th>Date</th><th>Document</th><th>Client</th><th>Article</th><th class="text-end">Qté livrée</th><th>UdM</th><th class="text-end">Stock restant</th></tr></thead><tbody><t t-foreach="data['lines']" t-as="line"><tr><td><t t-out="line['date'].strftime('%d/%m/%Y') if line['date'] else ''"/></td><td><t t-esc="line['document']"/></td><td><t t-esc="line['customer']"/></td><td><t t-esc="line['product'].display_name"/></td><td class="text-end"><t t-out="'{:,.2f}'.format(line['quantity'])"/></td><td><t t-esc="line['uom']"/></td><td class="text-end"><t t-out="'{:,.2f}'.format(line['stock_remaining'])"/></td></tr></t></tbody></table></div></t></template></odoo>
