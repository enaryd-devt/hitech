<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_customer_delivery_wizard_form" model="ir.ui.view">
    <field name="name">pt.customer.delivery.wizard.form</field>
    <field name="model">pt.customer.delivery.wizard</field>
    <field name="arch" type="xml">
      <form string="Produits déstockés / livrés" create="false">
        <sheet>
          <div class="oe_title"><h1>Rapport des produits déstockés / livrés</h1><p class="text-muted">Livraisons clients et stock restant à la fin de la période.</p></div>
          <group string="Période" col="4"><field name="date_from"/><field name="date_to"/><field name="company_id"/></group>
          <group string="Filtres" col="4"><field name="warehouse_ids" widget="many2many_tags"/><field name="category_ids" widget="many2many_tags"/><field name="product_ids" widget="many2many_tags"/><field name="customer_ids" widget="many2many_tags"/></group>
          <group string="Observations"><field name="observations" placeholder="Observations éventuelles à faire figurer sur le rapport..."/></group>
        </sheet>
        <footer>
          <button name="action_preview" type="object" string="Prévisualiser" class="btn-primary" icon="fa-search"/>
          <button name="action_print_pdf" type="object" string="Exporter PDF" icon="fa-file-pdf-o"/>
          <button name="action_export_xlsx" type="object" string="Exporter Excel" icon="fa-file-excel-o"/>
          <button string="Fermer" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="action_customer_delivery_wizard" model="ir.actions.act_window">
    <field name="name">Produits déstockés / livrés</field><field name="res_model">pt.customer.delivery.wizard</field><field name="view_mode">form</field><field name="target">new</field>
  </record>
</odoo>
