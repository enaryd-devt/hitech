<?xml version='1.0' encoding='utf-8'?>
<templates xml:space="preserve">
    <t t-name="primetech_reporting_center.StockDashboard">
        <div t-att-class="dashboardClass" t-att-style="dashboardStyle">
            <t t-if="state.loading"><div class="pt-stock-loading"><i class="fa fa-spinner fa-spin fa-3x"/><h4>Chargement du tableau de bord…</h4></div></t>
            <t t-if="!state.loading">
                <header class="pt-stock-header">
                    <div><h1>Stock &amp; Supply Chain</h1><p>Vue d’ensemble des articles, opérations et niveaux de stock.</p></div>
                    <div class="pt-stock-icons"><button title="Actualiser" t-on-click="refresh"><i class="fa fa-refresh"/></button><button title="Paramètres" t-on-click="openSettings"><i class="fa fa-cog"/></button></div>
                </header>
                <section class="pt-stock-filters">
                    <label>Entrepôt<select t-att-value="state.warehouseId" t-on-change="onWarehouseChange"><option value="">Tous les entrepôts</option><t t-foreach="state.data.warehouse_options" t-as="warehouse" t-key="warehouse.id"><option t-att-value="warehouse.id"><t t-esc="warehouse.name"/></option></t></select></label>
                    <label>Période<select t-att-value="state.period" t-on-change="onGlobalPeriodChange"><option value="today">Aujourd’hui</option><option value="week">Cette semaine</option><option value="month">Ce mois</option><option value="quarter">Ce trimestre</option><option value="year">Cette année</option><option value="custom">Période personnalisée</option></select></label>
                    <t t-if="state.period === 'custom'"><label>Du<input type="date" t-att-value="state.dateFrom" t-att-max="state.dateTo || undefined" t-on-change="(ev) => this.onGlobalDateChange('dateFrom', ev)"/></label><label>Au<input type="date" t-att-value="state.dateTo" t-att-min="state.dateFrom || undefined" t-on-change="(ev) => this.onGlobalDateChange('dateTo', ev)"/></label></t>
                    <span>Actualisé le : <t t-esc="state.data.updated_at"/></span>
                </section>
                <section class="pt-stock-reference__kpis">
                    <button class="pt-ref-kpi pt-ref-kpi--blue" t-on-click="() => this.openProducts()"><i class="fa fa-cube"/><div><span>Articles en stock</span><strong t-esc="state.data.products_count"/><small>Références actives</small></div></button>
                    <button class="pt-ref-kpi pt-ref-kpi--green" t-on-click="() => this.openProducts([['qty_available', '&gt;', 0]])"><i class="fa fa-cubes"/><div><span>Quantité disponible</span><strong t-esc="state.data.available_qty"/><small>Unités en stock</small></div></button>
                    <button class="pt-ref-kpi pt-ref-kpi--orange" t-on-click="() => this.openTransfers([['picking_type_id.code', '=', 'incoming'], ['state', 'not in', ['done', 'cancel']]])"><i class="fa fa-download"/><div><span>À recevoir</span><strong t-esc="incomingPending"/><small>Réceptions en attente</small></div></button>
                    <button class="pt-ref-kpi pt-ref-kpi--violet" t-on-click="() => this.openTransfers([['picking_type_id.code', '=', 'outgoing'], ['state', 'not in', ['done', 'cancel']]])"><i class="fa fa-truck"/><div><span>À livrer</span><strong t-esc="outgoingPending"/><small>Livraisons en attente</small></div></button>
                    <button class="pt-ref-kpi pt-ref-kpi--red" t-on-click="() => this.openTransfers([['scheduled_date', '&lt;', state.data.today], ['state', 'not in', ['done', 'cancel']]])"><i class="fa fa-exclamation-triangle"/><div><span>En retard</span><strong t-esc="state.data.alerts.late_replenishments"/><small>Opérations en retard</small></div></button>
                    <button class="pt-ref-kpi pt-ref-kpi--slate" t-on-click="() => this.openProducts()"><i class="fa fa-bar-chart"/><div><span>Valeur du stock</span><strong t-esc="money(state.data.stock_value)"/><small>Valorisation au coût</small></div></button>
                </section>
                <section class="pt-stock-reference__operations" t-foreach="state.data.operation_groups" t-as="warehouse" t-key="warehouse.name">
                    <header class="pt-ref-warehouse-title"><button t-on-click="() => this.openTransfers(warehouse.domain)"><i class="fa fa-building-o"/> Entrepôt : <t t-esc="warehouse.name"/></button><span t-esc="warehouse.cards.length"/> type(s) d’opération</header>
                    <div class="pt-ref-warehouse-cards">
                    <article t-foreach="warehouse.cards" t-as="operation" t-key="operation.id" t-attf-class="pt-ref-operation pt-ref-operation--#{operation.tone}">
                        <header><h2><i t-attf-class="fa #{operation.icon}"/> <t t-esc="operation.name"/></h2><em t-if="operation.late"><t t-esc="operation.late"/> en retard</em></header>
                        <div class="pt-ref-operation__number"><strong t-esc="operation.pending"/><span>à traiter</span></div>
                        <div class="pt-ref-operation__chart"><i/><i/><i/><i/><i/><i/><i/></div>
                        <button t-on-click="() => this.openTransfers(operation.domain)">Voir les opérations <i class="fa fa-arrow-right"/></button>
                    </article>
                    </div>
                </section>
                <section class="pt-stock-reference__grid">
                    <article class="pt-ref-panel pt-ref-panel--moves"><header><h2><i class="fa fa-refresh"/> Mouvements récents</h2><button t-on-click="() => this.openMoves()">Voir tout</button></header><div class="table-responsive"><table><thead><tr><th>Date</th><th>Opération</th><th>Référence</th><th>Article</th><th>Quantité</th></tr></thead><tbody><tr t-foreach="state.data.recent_moves" t-as="move" t-key="move.id" t-on-click="() => this.openMoves([['id', '=', move.id]])"><td t-esc="move.date"/><td><span t-attf-class="pt-ref-tag pt-ref-tag--#{move.type}" t-esc="move.operation"/></td><td t-esc="move.reference"/><td t-esc="move.product"/><td t-esc="move.quantity"/></tr></tbody></table></div></article>
                    <article class="pt-ref-panel pt-ref-panel--levels"><header><h2><i class="fa fa-pie-chart"/> Niveaux de stock</h2><button t-on-click="() => this.openProducts()">Voir les produits</button></header><div class="pt-ref-levels"><div class="pt-ref-donut"><strong t-esc="state.data.products_count"/><span>Articles</span></div><div><button t-foreach="state.data.stock_levels" t-as="level" t-key="level.label" class="pt-ref-level" t-on-click="() => this.openStockLevel(level)"><i t-attf-class="pt-ref-dot pt-ref-dot--#{level.tone}"/><span t-esc="level.label"/><strong t-esc="level.value"/></button></div></div></article>
                    <article class="pt-ref-panel pt-ref-panel--low"><header><h2><i class="fa fa-exclamation-triangle"/> Articles à réapprovisionner</h2><button t-on-click="() => this.openReplenishments()">Voir tout</button></header><div class="pt-ref-low" t-foreach="state.data.low_stock_products" t-as="product" t-key="product.id" t-on-click="() => this.openProducts([['id', '=', product.id]])"><img t-att-src="product.image_url"/><div><strong t-esc="product.name"/><small t-esc="product.reference"/></div><span t-attf-class="pt-ref-low__available pt-ref-low__available--#{product.level}" t-esc="product.available"/><span class="pt-ref-low__suggested" t-esc="product.suggested"/></div><p class="pt-ref-empty" t-if="!state.data.low_stock_products.length">Tous les stocks sont au niveau attendu.</p></article>
                    <article class="pt-ref-panel pt-ref-panel--category"><header><h2><i class="fa fa-bar-chart"/> Stock par catégorie</h2></header><div class="pt-ref-bars"><button t-foreach="state.data.category_data" t-as="category" t-key="category.name" class="pt-ref-bar" t-on-click="() => this.openCategory(category)"><div><i t-attf-style="height: #{category.quantity_ratio}%"/></div><strong t-esc="category.quantity"/><small t-esc="category.name"/></button></div></article>
                    <article class="pt-ref-panel pt-ref-panel--flow" t-on-click="() => this.openMoves()"><header><h2><i class="fa fa-line-chart"/> Entrées / Sorties</h2></header><div class="pt-ref-chart"><canvas id="stockMovementsChart"/></div></article>
                    <article class="pt-ref-panel pt-ref-panel--value"><header><h2><i class="fa fa-database"/> Valeur du stock</h2></header><button class="pt-ref-value" t-foreach="state.data.category_data" t-as="category" t-key="category.name" t-on-click="() => this.openCategory(category)"><span t-esc="category.name"/><div><i t-attf-style="width: #{category.value_ratio}%"/></div><strong t-esc="money(category.value)"/></button></article>
                </section>
            </t>
        </div>
    </t>
</templates>
