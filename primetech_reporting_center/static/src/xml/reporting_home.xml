<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="primetech_reporting_center.ReportingHome">
    <div class="p-4 bg-light h-100 overflow-auto">
      <div class="mb-4">
        <h1 class="h3 mb-1">Centre de reporting</h1>
        <p class="text-muted mb-0">Choisissez un rapport parmi les domaines auxquels vous avez accès.</p>
      </div>
      <div class="row g-3">
        <t t-foreach="state.actions" t-as="item" t-key="item.id">
          <div class="col-12 col-md-6 col-xl-4">
            <button class="btn btn-white border shadow-sm text-start w-100 h-100 p-4" t-on-click="() => this.open(item.id)">
              <i t-att-class="'fa ' + item.icon + ' fa-2x text-primary mb-3'"/>
              <div class="fw-bold fs-5"><t t-esc="item.title"/></div>
              <div class="text-muted mt-1"><t t-esc="item.description"/></div>
            </button>
          </div>
        </t>
      </div>
    </div>
  </t>
</templates>
